---
import type { LighthouseScoresFile } from './lighthouse-scores';
import PageQualityFooter from './PageQualityFooter.astro';
import SocialLinks from './SocialLinks.astro';

const today = new Date();

// Load Lighthouse scores if available; gracefully handle missing data.
let pageData = null;
try {
  const scoresFile: LighthouseScoresFile = (await import('../generated/lighthouse-scores.json'))
    .default;
  const currentRoute = Astro.url.pathname;
  const match = scoresFile.pages.find((p) => p.route === currentRoute);
  if (match) {
    pageData = match;
  }
} catch {
  // No generated scores data — render footer without quality line.
}
---

<footer class="site-frame" data-pagefind-ignore>
		&copy; {today.getFullYear()} Eric Carlisle. All rights reserved.
		<nav aria-label="Social links" class="social-links">
			<SocialLinks />
		</nav>
		<PageQualityFooter data={pageData} />
</footer>
<style>
footer {
  text-align: center;
  color: var(--text-secondary);
}

/* social links layout only */
.social-links {
  display: flex;
  justify-content: center;
  gap: var(--space-inline);
  margin-top: var(--space-component);
}

.social-links a {
  text-decoration: none;
  color: inherit;
}
</style>
