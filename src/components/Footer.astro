---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { AUTHOR_GITHUB, AUTHOR_LINKEDIN } from '../consts';
import { findPageData } from '../lib/lighthouse-utils';
import type { LighthousePageData, LighthouseScoresFile } from './lighthouse-scores';
import PageQualityFooter from './PageQualityFooter.astro';

const today = new Date();

// Load Lighthouse scores if available; gracefully handle missing data.
// Uses existsSync + readFileSync instead of dynamic import so Vite never
// fails to resolve a missing literal path during bundling.
let pageData: LighthousePageData | null = null;
try {
  // Allow override via environment variable for testing.
  // Falls back to the default path in the project.
  const dataPath =
    process.env.LIGHTHOUSE_SCORES_PATH ||
    join(process.cwd(), 'src', 'generated', 'lighthouse-scores.json');
  if (existsSync(dataPath)) {
    const raw = readFileSync(dataPath, 'utf-8');
    const scoresFile: LighthouseScoresFile = JSON.parse(raw);
    pageData = findPageData(scoresFile, Astro.url.pathname);
  }
} catch {
  // No generated scores data — render footer without quality line.
}
---

<footer class="site-frame" data-pagefind-ignore>
		&copy; {today.getFullYear()} Eric Carlisle. All rights reserved.
		<nav aria-label="Footer" class="footer-links">
			<a href={AUTHOR_LINKEDIN} target="_blank" rel="noopener">
				LinkedIn <span class="external-link-glyph" aria-hidden="true">↗</span>
				<span class="sr-only"> (opens in new tab)</span>
			</a>
			<a href={AUTHOR_GITHUB} target="_blank" rel="me noopener">
				GitHub <span class="external-link-glyph" aria-hidden="true">↗</span>
				<span class="sr-only"> (opens in new tab)</span>
			</a>
			<a href="/privacy/">Privacy</a>
		</nav>
		<PageQualityFooter data={pageData} />
</footer>
<style>
footer {
  text-align: center;
  color: var(--text-secondary);
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-inline-strong);
  margin-top: var(--space-component);
  font-size: var(--type-size-small);
}

.footer-links a {
  color: inherit;
  text-underline-offset: 0.15em;
}

.footer-links a:hover {
  color: var(--color-link);
}

.external-link-glyph {
  margin-left: 0.15em;
  font-family: var(--font-mono);
}
</style>
