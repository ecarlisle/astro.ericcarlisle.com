---
import {
  AUTHOR_AVATAR,
  AUTHOR_BLUESKY,
  AUTHOR_GITHUB,
  AUTHOR_JOB_TITLE,
  AUTHOR_LINKEDIN,
  AUTHOR_MASTODON,
  AUTHOR_NAME,
  AUTHOR_ORG,
  AUTHOR_WEBSITE,
} from '../consts';
import type { ResolvedTalk } from '../data/talks';
import type { ArticleModelMetadata, ResolvedArticleVideoMetadata } from '../lib/structured-data';

type PostItem = {
  title: string;
  url: string;
};

type Props = {
  type:
    | 'homepage'
    | 'about'
    | 'contact'
    | 'portfolio'
    | 'speaking'
    | 'article'
    | 'collection'
    | 'search'
    | 'not-found';
  title: string;
  description: string;
  url: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  collectionType?: 'main-feed' | 'tag-filter' | 'tags-index';
  tagName?: string;
  posts?: PostItem[];
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  wordCount?: number;
  video?: ResolvedArticleVideoMetadata;
  model3d?: ArticleModelMetadata;
  speakingTalks?: readonly ResolvedTalk[];
  breadcrumbs?: Array<{ name: string; item: string }>;
};

const {
  type,
  title,
  description,
  url,
  image,
  imageWidth,
  imageHeight,
  collectionType = 'main-feed',
  tagName,
  posts = [],
  pubDate,
  updatedDate,
  tags,
  wordCount,
  video,
  model3d,
  speakingTalks = [],
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ericcarlisle.com';
const pageUrl = url.replace(/\/$/, '');

const personEntity = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: AUTHOR_NAME,
  url: siteUrl,
  image: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#personImage`,
    url: `${siteUrl}${AUTHOR_AVATAR}`,
  },
  sameAs: [AUTHOR_WEBSITE, AUTHOR_GITHUB, AUTHOR_LINKEDIN, AUTHOR_BLUESKY, AUTHOR_MASTODON],
  jobTitle: AUTHOR_JOB_TITLE,
  worksFor: {
    '@type': 'Organization',
    name: AUTHOR_ORG,
  },
};

const websiteEntity = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: AUTHOR_NAME,
  publisher: { '@id': `${siteUrl}/#person` },
};

const blogEntity = {
  '@type': 'Blog',
  '@id': `${siteUrl}/#blog`,
  url: `${siteUrl}/blog/`,
  name: 'Blog',
  publisher: { '@id': `${siteUrl}/#person` },
};

const graphArray: object[] = [personEntity, websiteEntity, blogEntity];

// Build a BreadcrumbList from a breadcrumbs array
function buildBreadcrumb(urlPath: string, crumbs: Array<{ name: string; item: string }>) {
  return {
    '@type': 'BreadcrumbList',
    '@id': `${urlPath}/#breadcrumb`,
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  };
}

switch (type) {
  case 'homepage': {
    graphArray.push({
      '@type': 'ProfilePage',
      '@id': `${pageUrl}/#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntity: { '@id': `${siteUrl}/#person` },
    });
    break;
  }

  case 'collection': {
    const collectionPageEntity: Record<string, unknown> = {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}/#webpage`,
      url,
      name: collectionType === 'tag-filter' ? `Articles tagged with "${tagName}"` : title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
    };

    if (breadcrumbs) {
      collectionPageEntity.breadcrumb = buildBreadcrumb(pageUrl, breadcrumbs);
    } else if (collectionType === 'tag-filter' && tagName) {
      collectionPageEntity.breadcrumb = buildBreadcrumb(pageUrl, [
        { name: 'Home', item: siteUrl },
        { name: 'Tags', item: `${siteUrl}/tags` },
        { name: tagName, item: url },
      ]);
    } else if (collectionType === 'tags-index') {
      collectionPageEntity.breadcrumb = buildBreadcrumb(pageUrl, [
        { name: 'Home', item: siteUrl },
        { name: 'Tags', item: `${siteUrl}/tags` },
      ]);
    } else if (collectionType === 'main-feed') {
      collectionPageEntity.breadcrumb = buildBreadcrumb(pageUrl, [
        { name: 'Home', item: siteUrl },
        { name: 'Blog', item: url },
      ]);
    }

    if (posts.length > 0) {
      collectionPageEntity.mainEntity = {
        '@type': 'ItemList',
        numberOfItems: posts.length,
        itemListElement: posts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.title,
          url: post.url.startsWith('http') ? post.url : `${siteUrl}${post.url}`,
        })),
      };
    }

    graphArray.push(collectionPageEntity);
    break;
  }

  case 'article': {
    const webpageId = `${pageUrl}/#webpage`;
    const articleId = `${pageUrl}/#article`;
    const breadcrumbId = `${pageUrl}/#breadcrumb`;
    const primaryImageId = `${pageUrl}/#primaryimage`;
    const videoId = `${pageUrl}/#timelapse`;
    const modelId = `${pageUrl}/#3d-model`;
    const articleBreadcrumb = breadcrumbs
      ? buildBreadcrumb(pageUrl, breadcrumbs)
      : {
          '@type': 'BreadcrumbList',
          '@id': breadcrumbId,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
            { '@type': 'ListItem', position: 3, name: title, item: url },
          ],
        };

    const blogPostingEntity: Record<string, unknown> = {
      '@type': 'BlogPosting',
      '@id': articleId,
      url,
      mainEntityOfPage: { '@id': webpageId },
      headline: title,
      description,
      ...(pubDate && {
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
      }),
      ...(tags &&
        tags.length > 0 && {
          articleSection: tags.join(', '),
          keywords: tags.join(', '),
        }),
      isPartOf: { '@id': `${siteUrl}/#blog` },
      ...(wordCount && { wordCount }),
      ...(wordCount && { timeRequired: `PT${Math.ceil(wordCount / 200)}M` }),
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      image: {
        '@type': 'ImageObject',
        '@id': primaryImageId,
        url: image.startsWith('http') ? image : `${siteUrl}${image}`,
        width: imageWidth,
        height: imageHeight,
      },
      inLanguage: 'en-US',
    };

    if (video) {
      blogPostingEntity.video = { '@id': videoId };
    }

    if (model3d) {
      blogPostingEntity.hasPart = [{ '@id': modelId }];
    }

    graphArray.push(
      {
        '@type': 'WebPage',
        '@id': webpageId,
        url,
        name: title,
        description,
        isPartOf: { '@id': `${siteUrl}/#website` },
        breadcrumb: { '@id': breadcrumbId },
        primaryImageOfPage: { '@id': primaryImageId },
        mainEntity: { '@id': articleId },
      },
      blogPostingEntity,
      articleBreadcrumb,
    );

    if (video) {
      graphArray.push({
        '@type': 'VideoObject',
        '@id': videoId,
        name: video.name,
        description: video.description,
        thumbnailUrl: video.thumbnailUrl,
        uploadDate: video.uploadDate,
        duration: video.duration,
        embedUrl: video.embedUrl,
      });
    }

    if (model3d) {
      graphArray.push({
        '@type': '3DModel',
        '@id': modelId,
        name: model3d.name,
        description: model3d.description,
        contentUrl: model3d.contentUrl,
        encodingFormat: model3d.encodingFormat,
        creator: { '@id': `${siteUrl}/#person` },
      });
    }
    break;
  }

  case 'about':
  case 'contact':
    graphArray.push({
      '@type': type === 'about' ? 'ProfilePage' : 'ContactPage',
      '@id': `${pageUrl}/#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntity: { '@id': `${siteUrl}/#person` },
    });
    break;

  case 'portfolio': {
    const portfolioEntity: Record<string, unknown> = {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}/#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      author: { '@id': `${siteUrl}/#person` },
    };

    if (breadcrumbs) {
      portfolioEntity.breadcrumb = buildBreadcrumb(pageUrl, breadcrumbs);
    }

    graphArray.push(portfolioEntity);
    break;
  }

  case 'speaking': {
    const webpageId = `${pageUrl}/#webpage`;
    const talksId = `${pageUrl}/#talks`;
    const breadcrumbId = `${pageUrl}/#breadcrumb`;

    const speakingPageEntity: Record<string, unknown> = {
      '@type': 'CollectionPage',
      '@id': webpageId,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      author: { '@id': `${siteUrl}/#person` },
      mainEntity: { '@id': talksId },
      breadcrumb: { '@id': breadcrumbId },
    };

    const speakingBreadcrumb = breadcrumbs
      ? buildBreadcrumb(pageUrl, breadcrumbs)
      : buildBreadcrumb(pageUrl, [
          { name: 'Home', item: `${siteUrl}/` },
          { name: 'Selected Talks', item: url },
        ]);

    graphArray.push(
      speakingPageEntity,
      {
        '@type': 'ItemList',
        '@id': talksId,
        numberOfItems: speakingTalks.length,
        itemListElement: speakingTalks.map((talk, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: { '@id': `${pageUrl}/#video-${talk.videoId}` },
        })),
      },
      speakingBreadcrumb,
    );

    for (const talk of speakingTalks) {
      const eventId = `${pageUrl}/#event-${talk.videoId}`;
      graphArray.push({
        '@type': 'VideoObject',
        '@id': `${pageUrl}/#video-${talk.videoId}`,
        name: talk.title,
        description: talk.description,
        thumbnailUrl: talk.thumbnailUrl,
        uploadDate: talk.uploadDate,
        duration: talk.duration,
        embedUrl: `https://www.youtube-nocookie.com/embed/${talk.videoId}`,
        creator: { '@id': `${siteUrl}/#person` },
        ...(talk.eventDate && talk.eventUrl && { recordedAt: { '@id': eventId } }),
      });

      if (talk.eventDate && talk.eventUrl) {
        graphArray.push({
          '@type': 'Event',
          '@id': eventId,
          name: `${talk.event} ${talk.year}`,
          startDate: talk.eventDate,
          url: talk.eventUrl,
          performer: { '@id': `${siteUrl}/#person` },
        });
      }
    }
    break;
  }

  case 'search':
    graphArray.push({
      '@type': 'SearchResultsPage',
      '@id': `${pageUrl}/#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
    });
    break;

  case 'not-found':
    break;
}

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': graphArray,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
