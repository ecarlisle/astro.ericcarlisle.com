---
/**
 * PageQualityFooter — compact Lighthouse score report for the site footer.
 *
 * Reads generated deployment-audit data and renders a subdued line with
 * per-category scores. The component is self-contained, uses no client
 * JavaScript, and gracefully degrades when no score data is available.
 */
import type { LighthousePageData } from './lighthouse-scores';

interface Props {
  /** Pre-resolved score data for the current page. */
  data?: LighthousePageData | null;
}

const { data } = Astro.props;

// If no data, render nothing — the footer stays clean.
if (!data) return;
---

<p class="page-quality-footer" role="contentinfo" aria-label="Page quality scores">
  <a href="/portfolio/site-quality/" class="page-quality-link">
    <span class="sr-only">Page quality: </span>
    <span aria-hidden="true">Deployment audit ·</span>
    <span class="page-quality-score">
      <abbr title={'Performance: ' + data.scores.performance + ' out of 100'} aria-label={'Performance score ' + data.scores.performance}>P&nbsp;{data.scores.performance}</abbr>
    </span>
    <span class="page-quality-score">
      <abbr title={'Accessibility: ' + data.scores.accessibility + ' out of 100'} aria-label={'Accessibility score ' + data.scores.accessibility}>A&nbsp;{data.scores.accessibility}</abbr>
    </span>
    <span class="page-quality-score">
      <abbr title={'Best Practices: ' + data.scores.bestPractices + ' out of 100'} aria-label={'Best Practices score ' + data.scores.bestPractices}>BP&nbsp;{data.scores.bestPractices}</abbr>
    </span>
    <span class="page-quality-score">
      <abbr title={'SEO: ' + data.scores.seo + ' out of 100'} aria-label={'Search Engine Optimization score ' + data.scores.seo}>SEO&nbsp;{data.scores.seo}</abbr>
    </span>
  </a>
</p>

<style>
  .page-quality-footer {
    margin-top: var(--space-component);
    font-size: var(--type-size-small);
    line-height: var(--line-height-body);
    text-align: center;
  }

  .page-quality-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .page-quality-link:hover {
    color: var(--text-secondary);
  }

  .page-quality-score {
    display: inline;
    white-space: nowrap;
  }

  .page-quality-score abbr {
    font-family: var(--font-mono);
    font-size: 0.9em;
    letter-spacing: var(--letter-spacing-label);
    text-decoration: none;
    cursor: default;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
