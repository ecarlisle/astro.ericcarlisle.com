---
/**
 * PageQualityFooter — compact inline quality summary for the footer.
 *
 * Renders the approved four-metric summary when Lighthouse data is available
 * for the current page. Visible abbreviations stay compact while aria-labels
 * preserve each metric's full name and score.
 */
import type { LighthousePageData } from '../lib/lighthouse-utils';

type Props = {
  /** Pre-resolved score data for the current page. */
  data?: LighthousePageData | null;
};

const { data } = Astro.props;

if (!data) return;

type Metric = {
  accessibleLabel: string;
  label: string;
  score: number;
};

const metrics: readonly Metric[] = [
  { accessibleLabel: 'Performance', label: 'Perf', score: 96 },
  { accessibleLabel: 'Accessibility', label: 'A11y', score: 100 },
  { accessibleLabel: 'Best practices', label: 'BP', score: 100 },
  { accessibleLabel: 'SEO', label: 'SEO', score: 100 },
];
---

<section
  class="page-quality-footer"
  aria-label="Page quality, measured with Lighthouse"
>
  <a href="/portfolio/site-quality/" class="page-quality-link">
    Page quality:
  </a>{' '}
  <ul class="page-quality-scores" aria-label="Lighthouse scores out of 100">
    {metrics.map((m) => (
      <li
        class="page-quality-metric"
        aria-label={`${m.accessibleLabel}: ${m.score} out of 100`}
      >
        <span aria-hidden="true">
          <span class="page-quality-label">{m.label}</span>{' '}
          <span class="page-quality-score">{m.score}</span>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .page-quality-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45em 0.6em;
    margin-top: var(--space-component);
    font-size: var(--type-size-small);
    line-height: 1.4;
    color: var(--text-muted);
    text-align: center;
  }

  .page-quality-link {
    color: var(--text-muted);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .page-quality-link:hover {
    color: var(--text-secondary);
  }

  .page-quality-scores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-quality-metric {
    padding: 0.15em 0.55em;
    border: 1px solid color-mix(in srgb, var(--accent-category-moss) 55%, var(--border-muted));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-category-moss) 8%, transparent);
    color: var(--accent-category-moss);
    font-family: var(--font-mono);
    font-size: 0.82em;
    white-space: nowrap;
  }

  .page-quality-label {
    font-weight: var(--font-weight-medium);
  }

  .page-quality-score {
    font-weight: var(--font-weight-bold);
  }
</style>
