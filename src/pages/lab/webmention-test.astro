---
/**
 * Webmention Integration Test — withdrawal notice.
 *
 * This page previously served as a controlled source for Webmention
 * integration testing. The test has been completed and the mention
 * withdrawn. This page remains only to provide a permanent 200 at the
 * same URL while Webmention.io processes the withdrawal.
 *
 * See scripts/test-webmention-production.mjs for --withdraw usage.
 */
import '../../styles/global.css';

const SOURCE_CANONICAL = 'https://ericcarlisle.com/lab/webmention-test/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Webmention Integration Test — Eric Carlisle</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={SOURCE_CANONICAL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        font-family: var(--font-copy, system-ui, sans-serif);
        max-width: 40rem;
        margin: 2rem auto;
        padding: 1rem;
        color: var(--text-primary, #111);
        line-height: 1.6;
      }
      h1 { font-size: 1.25rem; }
      .note {
        font-size: 0.875rem;
        color: var(--text-muted, #666);
        border-left: 3px solid var(--brand-highlight, #f5a623);
        padding-left: 1rem;
        margin-top: 1.5rem;
      }
      .withdrawn {
        font-size: 1rem;
        border: 1px solid var(--border-muted, #ccc);
        border-radius: 6px;
        padding: 1rem;
        background: var(--bg-surface, #fafafa);
      }
    </style>
  </head>
  <body data-pagefind-ignore="all">
    <h1>Webmention Integration Test</h1>

    <p class="withdrawn">
      <strong>Test completed.</strong> The temporary Webmention integration
      test has been completed and withdrawn. No link to any article exists
      on this page.
    </p>

    <p class="note">
      This controlled integration-test source page remains live so that
      Webmention.io can re-fetch and confirm the link removal. It is
      excluded from search results, site navigation, and sitemaps.
      It will be removed once withdrawal is complete.
    </p>
  </body>
</html>
