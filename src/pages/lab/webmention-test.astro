---
/**
 * Webmention Integration Test — temporary source page.
 *
 * This page exists solely to provide a publicly fetchable source for
 * Webmention integration testing. It is excluded from search indexing,
 * sitemaps, and Pagefind. See scripts/test-webmention-production.mjs
 * for the end-to-end test workflow.
 */
import '../../styles/global.css';

const TARGET_URL = 'https://ericcarlisle.com/blog/250mm-trading-card-box/';
const SOURCE_CANONICAL = 'https://ericcarlisle.com/lab/webmention-test/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Webmention Integration Test — Eric Carlisle</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={SOURCE_CANONICAL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        font-family: var(--font-copy, system-ui, sans-serif);
        max-width: 40rem;
        margin: 2rem auto;
        padding: 1rem;
        color: var(--text-primary, #111);
        line-height: 1.6;
      }
      h1 { font-size: 1.25rem; }
      .note {
        font-size: 0.875rem;
        color: var(--text-muted, #666);
        border-left: 3px solid var(--brand-highlight, #f5a623);
        padding-left: 1rem;
        margin-top: 1.5rem;
      }
    </style>
  </head>
  <body data-pagefind-ignore="all">
    <h1>Webmention Integration Test</h1>

    <article class="h-entry">
      <p class="p-content">
        Temporary Webmention integration test replying to{' '}
        <a class="u-in-reply-to" href={TARGET_URL}>
          250mm Trading Card Box, a 3D Print
        </a>.
      </p>

      <footer>
        <span class="h-card p-author">
          <span class="p-name">Eric Carlisle</span>
        </span>
        —
        <a class="u-url" href={SOURCE_CANONICAL}>permalink</a>
      </footer>
    </article>

    <p class="note">
      This is a controlled, temporary integration-test source page.
      It is excluded from search results and site navigation.
      It remains only as long as the Webmention integration test requires it.
    </p>
  </body>
</html>
