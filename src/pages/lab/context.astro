---
import '../../styles/global.css';
import ContextCheckCard from '../../components/lab/ContextCheckCard.astro';

interface EvidenceCitation {
  path: string;
  section?: string;
  startLine?: number;
  endLine?: number;
}

interface ContextCheck {
  id: string;
  label: string;
  weight: number;
  result: 'pass' | 'partial' | 'fail';
  impact: 'positive' | 'negative';
  interpretation: string;
  contribution: number;
  evidence: { observation: string; citations: EvidenceCitation[] };
}

type AssessedStatus = 'complete-for-current-static-checks' | 'gaps-found' | 'declared-estimate';
type ObservedStatus = 'not-measured' | 'measured' | 'insufficient-evidence';

interface ContextMetric {
  id: string;
  label: string;
  assessed: {
    score: number | null;
    status: AssessedStatus;
    evidenceMaturity: 'declared' | 'structurally-verified' | 'observed' | 'repeated' | 'resilient';
    evidenceMaturityReason: string;
    interpretation: string;
    limitations: string[];
    checks?: ContextCheck[];
    details?: {
      characters: number;
      estimatedTokens: number;
      estimationMethod: string;
      measuredFiles: Array<{ path: string; characters: number }>;
    };
  };
  observed: {
    status: ObservedStatus;
    score: number | null;
    numerator: number | null;
    denominator: number | null;
    taskCount: number;
    runCount: number;
    agentConfigurationCount: number;
    repositoryRevision: string | null;
    evaluationSuiteVersion: string | null;
    variation: string | null;
    confidence: string | null;
    authorityDiagnostics: {
      unresolvedConflictCount: number | null;
      ambiguousAreas: string[];
      expectedControllingSources: string[];
      decisionEvidence: string[];
    } | null;
    interpretation: string;
    limitations: string[];
  };
}

interface ContextHealthReport {
  schemaVersion: string;
  auditedAt: string;
  repositoryRevision: string;
  effectiveContext: {
    id: string;
    version: string;
    name: string;
    status: 'static-assessed';
    selectionRule: string;
    files: string[];
  };
  profileCoverage: Array<{
    id: string;
    version: string | null;
    label: string;
    status: 'static-assessed' | 'not-evaluated';
    note: string;
  }>;
  overallSummary: string;
  strengths: string[];
  priorities: Array<{ priority: number; finding: string; recommendation: string }>;
  metrics: ContextMetric[];
  methodology: {
    id: string;
    version: string;
    status: 'experimental';
    evidenceMaturityVersion: string;
    scoreCalculation: string;
    assessmentBoundary: string;
    tokenEstimation: { formula: string; charactersPerToken: number; note: string };
    observedSizeMeasures: string[];
    evidenceMaturityLevels: Array<{ id: string; definition: string }>;
    scenarioTaxonomy: string[];
    foundations: Array<{ label: string; url: string; adaptation: string }>;
  };
  limitations: string[];
}

const report = (await import('../../data/context-health.json')).default as ContextHealthReport;

const statusLabels: Record<
  AssessedStatus | ObservedStatus | 'static-assessed' | 'not-evaluated',
  string
> = {
  'complete-for-current-static-checks': 'Complete for current static checks',
  'gaps-found': 'Gaps found',
  'declared-estimate': 'Declared estimate',
  'not-measured': 'Not yet measured',
  measured: 'Measured',
  'insufficient-evidence': 'Insufficient evidence',
  'static-assessed': 'Static assessed',
  'not-evaluated': 'Not evaluated',
};

function percentage(score: number | null) {
  return score === null ? '—' : `${Math.round(score * 100)}%`;
}

function formatNumber(value: number | undefined) {
  return value === undefined ? '—' : value.toLocaleString('en-US');
}

function assessedValue(metric: ContextMetric) {
  return metric.id === 'active-context-size'
    ? `${formatNumber(metric.assessed.details?.characters)} code units`
    : percentage(metric.assessed.score);
}

function maturityLabel(value: string) {
  const label = value.replaceAll('-', ' ');
  return `${label.charAt(0).toUpperCase()}${label.slice(1)}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Context Health: EricCarlisle.com</title>
    <meta
      name="description"
      content="An experimental static assessment of coding-agent context readiness, with observed performance reported separately."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      .ch-page {
        max-width: var(--layout-rail-page);
        margin-inline: auto;
        padding: var(--space-layout) var(--space-component);
        color: var(--text-primary);
      }

      .ch-page__heading,
      .ch-section-heading,
      .ch-page h3 {
        font-family: var(--font-headers);
      }

      .ch-page__heading {
        margin: 0 0 var(--space-xs);
        font-size: var(--type-size-h2);
        line-height: var(--line-height-h2);
        text-wrap: balance;
      }

      .ch-page__meta,
      .ch-score__eyebrow,
      .ch-check__weight,
      .ch-file-table,
      .ch-mode__metadata {
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
      }

      .ch-page__meta {
        margin: 0 0 var(--space-xl);
        color: var(--text-muted);
      }

      .ch-page__disclaimer {
        margin-bottom: var(--space-section);
        padding: var(--space-component);
        border-left: var(--size-border-thick) solid var(--brand-highlight);
        border-radius: var(--radius-md);
        background: var(--bg-surface);
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.6;
      }

      .ch-overview,
      .ch-scores,
      .ch-profile-coverage,
      .ch-details {
        margin-bottom: var(--space-section);
      }

      .ch-overview__summary {
        max-width: var(--layout-rail-prose);
        margin: 0 0 var(--space-lg);
        line-height: 1.6;
      }

      .ch-overview__columns,
      .ch-mode-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-component-lg);
      }

      .ch-overview h3,
      .ch-mode h3 {
        margin: 0 0 var(--space-sm);
        font-size: var(--type-size-h5);
      }

      .ch-overview ul,
      .ch-overview ol,
      .ch-mode ul {
        margin: 0;
      }

      .ch-overview ul {
        padding: 0;
        list-style: none;
      }

      .ch-overview ol,
      .ch-mode ul {
        padding-inline-start: var(--space-component-lg);
      }

      .ch-overview li {
        padding: var(--space-xs) 0;
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
        font-size: var(--type-size-small);
        line-height: 1.5;
      }

      .ch-priority__recommendation {
        display: block;
        margin-top: var(--space-xs);
        color: var(--brand-accent);
      }

      .ch-scores,
      .ch-profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
        gap: var(--space-component);
      }

      .ch-score,
      .ch-profile,
      .ch-details > details,
      .ch-methodology details {
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        background: var(--color-card-bg);
      }

      .ch-score,
      .ch-profile {
        padding: var(--space-component);
      }

      .ch-score__eyebrow {
        margin: 0 0 var(--space-xs);
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .ch-score__value {
        margin-bottom: var(--space-xs);
        color: var(--color-link);
        font-family: var(--font-headers);
        font-size: var(--type-size-h3);
        font-weight: var(--font-weight-bold);
        line-height: 1.1;
      }

      .ch-score__value--size {
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: var(--type-size-body);
      }

      .ch-score__label,
      .ch-profile h3 {
        margin: 0 0 var(--space-xs);
        font-size: var(--type-size-body);
      }

      .ch-status {
        display: inline-block;
        margin-bottom: var(--space-xs);
        padding: 0.15em 0.55em;
        border: var(--size-border-pixel) solid currentColor;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        font-weight: var(--font-weight-bold);
      }

      .ch-status--complete-for-current-static-checks,
      .ch-status--static-assessed {
        color: var(--color-success);
      }

      .ch-status--gaps-found {
        color: var(--brand-accent);
      }

      .ch-status--declared-estimate {
        color: var(--color-link);
      }

      .ch-status--not-measured,
      .ch-status--not-evaluated,
      .ch-status--insufficient-evidence {
        color: var(--text-muted);
      }

      .ch-score__interp,
      .ch-score__observed,
      .ch-profile p,
      .ch-mode p,
      .ch-mode li,
      .ch-methodology p,
      .ch-methodology li {
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.6;
      }

      .ch-score__interp {
        margin: 0 0 var(--space-sm);
      }

      .ch-score__observed {
        margin: 0;
        padding-top: var(--space-sm);
        border-top: var(--size-border-pixel) solid var(--border-muted);
      }

      .ch-section-heading {
        margin: 0 0 var(--space-component);
        font-size: var(--type-size-h4);
      }

      .ch-details > details,
      .ch-methodology details {
        margin-bottom: var(--space-component);
        padding: var(--space-component);
      }

      .ch-page summary {
        cursor: pointer;
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        overflow-wrap: anywhere;
      }

      .ch-page summary:focus-visible {
        border-radius: var(--radius-sm);
        outline: var(--focus-outline-width) var(--focus-outline-style) var(--color-focus);
        outline-offset: var(--focus-outline-offset);
      }

      .ch-page details[open] > summary {
        margin-bottom: var(--space-component);
        padding-bottom: var(--space-component);
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
      }

      .ch-mode {
        min-width: 0;
      }

      .ch-mode--observed {
        padding-left: var(--space-component);
        border-left: var(--size-border-pixel) solid var(--border-muted);
      }

      .ch-mode__metadata {
        color: var(--text-muted);
        overflow-wrap: anywhere;
      }

      .ch-contributors {
        display: grid;
        gap: var(--space-component);
        margin-top: var(--space-component);
      }

      .ch-contributor-group h4 {
        margin: 0 0 var(--space-sm);
        font-family: var(--font-headers);
        font-size: var(--type-size-body);
      }

      .ch-check {
        margin-bottom: var(--space-sm);
        padding: var(--space-sm);
        border-left: var(--size-border-thick) solid var(--border-main);
        border-radius: var(--radius-md);
        background: var(--bg-surface-elevated);
      }

      .ch-check--positive {
        border-left-color: var(--color-success);
      }

      .ch-check--negative {
        border-left-color: var(--brand-highlight);
      }

      .ch-check__header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
        font-size: var(--type-size-small);
      }

      .ch-check__label,
      .ch-check__result {
        color: var(--text-primary);
        font-weight: var(--font-weight-bold);
      }

      .ch-check__result {
        flex: none;
        font-family: var(--font-mono);
      }

      .ch-check__evidence,
      .ch-check__interpretation {
        margin: var(--space-xs) 0 0;
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.5;
      }

      .ch-check__citations {
        margin: var(--space-xs) 0 0;
        padding-left: var(--space-component);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        overflow-wrap: anywhere;
      }

      .ch-check__weight {
        margin-top: var(--space-xs);
        color: var(--text-muted);
      }

      .ch-size-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-component);
      }

      .ch-size-stat {
        padding: var(--space-component);
        border-radius: var(--radius-md);
        background: var(--bg-surface-elevated);
        text-align: center;
      }

      .ch-size-stat__value {
        color: var(--color-link);
        font-family: var(--font-headers);
        font-size: var(--type-size-h3);
        font-weight: var(--font-weight-bold);
      }

      .ch-size-stat__label,
      .ch-size-note {
        color: var(--text-muted);
        font-size: var(--type-size-small);
      }

      .ch-file-table-wrap {
        max-width: 100%;
        overflow-x: auto;
      }

      .ch-file-table {
        width: 100%;
        border-collapse: collapse;
      }

      .ch-file-table th,
      .ch-file-table td {
        padding: var(--space-xs) var(--space-inline);
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
        text-align: left;
      }

      .ch-file-table td {
        color: var(--text-secondary);
        overflow-wrap: anywhere;
      }

      .ch-file-table th:last-child,
      .ch-file-table td:last-child {
        text-align: right;
        white-space: nowrap;
      }

      .ch-methodology {
        padding-top: var(--space-section);
        border-top: var(--size-border-pixel) solid var(--border-main);
      }

      .ch-methodology h3 {
        margin: var(--space-component) 0 var(--space-sm);
        font-size: var(--type-size-body);
      }

      .ch-methodology p,
      .ch-methodology li {
        max-width: var(--layout-rail-prose);
      }

      @media (max-width: 720px) {
        .ch-overview__columns,
        .ch-mode-grid,
        .ch-size-grid {
          grid-template-columns: 1fr;
        }

        .ch-mode--observed {
          padding-top: var(--space-component);
          padding-left: 0;
          border-top: var(--size-border-pixel) solid var(--border-muted);
          border-left: 0;
        }

        .ch-check__header {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="ch-page" data-pagefind-ignore="all">
      <h1 class="ch-page__heading">Context Health: EricCarlisle.com</h1>
      <p class="ch-page__meta">
        Audited {report.auditedAt} · Revision {report.repositoryRevision} · Schema v{report.schemaVersion}
        · {report.methodology.id} v{report.methodology.version}
      </p>

      <aside class="ch-page__disclaimer">
        <strong>Experimental methodology; no observed task performance yet.</strong> Static
        assessment reports repository readiness for one declared profile. Observed results require
        representative task runs and are shown separately as not measured. No aggregate score is
        calculated. A 100% static score means only that all finite checks in this profile passed.
        The next evidence step is a versioned suite of representative task runs.
      </aside>

      <section class="ch-overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="ch-section-heading">Overview</h2>
        <p class="ch-overview__summary">{report.overallSummary}</p>
        <div class="ch-overview__columns">
          <div>
            <h3>Key strengths</h3>
            <ul>{report.strengths.map((strength) => <li>{strength}</li>)}</ul>
          </div>
          <div>
            <h3>Prioritized improvements</h3>
            <ol>
              {
                report.priorities.map((priority) => (
                  <li>
                    <strong>{priority.finding}</strong>
                    <span class="ch-priority__recommendation">{priority.recommendation}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section aria-labelledby="scores-heading">
        <h2 id="scores-heading" class="ch-section-heading">Static assessment</h2>
        <div class="ch-scores">
          {
            report.metrics.map((metric) => (
              <article class="ch-score">
                <p class="ch-score__eyebrow">Assessed</p>
                <div
                  class:list={[
                    'ch-score__value',
                    metric.id === 'active-context-size' && 'ch-score__value--size',
                  ]}
                >
                  {assessedValue(metric)}
                </div>
                <h3 class="ch-score__label">{metric.label}</h3>
                <div class:list={['ch-status', `ch-status--${metric.assessed.status}`]}>
                  {statusLabels[metric.assessed.status]}
                </div>
                <p class="ch-score__interp">{metric.assessed.interpretation}</p>
                <p class="ch-score__observed">
                  <strong>Observed:</strong> {statusLabels[metric.observed.status]}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="ch-profile-coverage" aria-labelledby="coverage-heading">
        <h2 id="coverage-heading" class="ch-section-heading">Profile coverage</h2>
        <div class="ch-profile-grid">
          {
            report.profileCoverage.map((profile) => (
              <article class="ch-profile">
                <h3>{profile.label}</h3>
                <div class:list={['ch-status', `ch-status--${profile.status}`]}>
                  {statusLabels[profile.status]}
                </div>
                <p>{profile.note}</p>
                {profile.version && <p class="ch-mode__metadata">Profile v{profile.version}</p>}
              </article>
            ))
          }
        </div>
      </section>

      <section class="ch-details" aria-labelledby="details-heading">
        <h2 id="details-heading" class="ch-section-heading">Metric evidence</h2>
        {
          report.metrics.map((metric) => {
            const positive =
              metric.assessed.checks?.filter((check) => check.impact === 'positive') ?? [];
            const negative =
              metric.assessed.checks?.filter((check) => check.impact === 'negative') ?? [];
            return (
              <details>
                <summary>
                  {metric.label}: assessed {assessedValue(metric)}; observed{' '}
                  {statusLabels[metric.observed.status].toLowerCase()}
                </summary>
                <div class="ch-mode-grid">
                  <section class="ch-mode ch-mode--assessed">
                    <h3>Static assessed</h3>
                    <div class:list={['ch-status', `ch-status--${metric.assessed.status}`]}>
                      {statusLabels[metric.assessed.status]}
                    </div>
                    <p>
                      <strong>Evidence maturity:</strong>{' '}
                      {maturityLabel(metric.assessed.evidenceMaturity)}.{' '}
                      {metric.assessed.evidenceMaturityReason}
                    </p>
                    <p>{metric.assessed.interpretation}</p>
                    <ul>
                      {metric.assessed.limitations.map((limitation) => <li>{limitation}</li>)}
                    </ul>

                    {metric.assessed.checks && (
                      <div class="ch-contributors">
                        {positive.length > 0 && (
                          <section
                            class="ch-contributor-group"
                            aria-label={`${metric.label} positives`}
                          >
                            <h4>Positive contributors</h4>
                            {positive.map((check) => (
                              <ContextCheckCard
                                check={check}
                                repositoryRevision={report.repositoryRevision}
                              />
                            ))}
                          </section>
                        )}
                        {negative.length > 0 && (
                          <section
                            class="ch-contributor-group"
                            aria-label={`${metric.label} negatives`}
                          >
                            <h4>Negative contributors</h4>
                            {negative.map((check) => (
                              <ContextCheckCard
                                check={check}
                                repositoryRevision={report.repositoryRevision}
                              />
                            ))}
                          </section>
                        )}
                      </div>
                    )}

                    {metric.assessed.details && (
                      <div>
                        <div class="ch-size-grid">
                          <div class="ch-size-stat">
                            <div class="ch-size-stat__value">
                              {formatNumber(metric.assessed.details.characters)}
                            </div>
                            <div class="ch-size-stat__label">UTF-16 code units</div>
                          </div>
                          <div class="ch-size-stat">
                            <div class="ch-size-stat__value">
                              ~{formatNumber(metric.assessed.details.estimatedTokens)}
                            </div>
                            <div class="ch-size-stat__label">Estimated tokens</div>
                          </div>
                        </div>
                        <p class="ch-size-note">
                          <strong>{report.effectiveContext.name}:</strong>{' '}
                          {report.effectiveContext.selectionRule}
                        </p>
                        <p class="ch-size-note">{metric.assessed.details.estimationMethod}</p>
                        <div class="ch-file-table-wrap">
                          <table class="ch-file-table">
                            <thead>
                              <tr>
                                <th scope="col">Declared file</th>
                                <th scope="col">UTF-16 code units</th>
                              </tr>
                            </thead>
                            <tbody>
                              {metric.assessed.details.measuredFiles.map((file) => (
                                <tr>
                                  <td>{file.path}</td>
                                  <td>{formatNumber(file.characters)}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )}
                  </section>

                  <section class="ch-mode ch-mode--observed">
                    <h3>Observed performance</h3>
                    <div class:list={['ch-status', `ch-status--${metric.observed.status}`]}>
                      {statusLabels[metric.observed.status]}
                    </div>
                    <p><strong>No observed evidence yet.</strong> {metric.observed.interpretation}</p>
                    <p class="ch-mode__metadata">
                      Tasks {metric.observed.taskCount} · Runs {metric.observed.runCount} · Agent
                      configurations {metric.observed.agentConfigurationCount} · Suite not assigned
                    </p>
                    <ul>
                      {metric.observed.limitations.map((limitation) => <li>{limitation}</li>)}
                    </ul>
                  </section>
                </div>
              </details>
            );
          })
        }
      </section>

      <section class="ch-methodology" aria-labelledby="methodology-heading">
        <h2 id="methodology-heading" class="ch-section-heading">Methodology</h2>
        <details open>
          <summary>Assessment boundaries</summary>
          <p>{report.methodology.assessmentBoundary}</p>
          <p>{report.methodology.scoreCalculation}</p>
          <p>
            Token estimate: {report.methodology.tokenEstimation.formula}.{' '}
            {report.methodology.tokenEstimation.note}
          </p>
          <h3>Future observed size measures</h3>
          <ul>
            {report.methodology.observedSizeMeasures.map((measure) => <li>{measure}</li>)}
          </ul>
        </details>
        <details>
          <summary>Evidence maturity v{report.methodology.evidenceMaturityVersion}</summary>
          <ul>
            {
              report.methodology.evidenceMaturityLevels.map((level) => (
                <li>
                  <strong>{maturityLabel(level.id)}:</strong> {level.definition}
                </li>
              ))
            }
          </ul>
        </details>
        <details>
          <summary>Future observed scenario taxonomy</summary>
          <p>
            These categories document a future evaluation suite. This report does not implement a
            runner, simulator, or telemetry system.
          </p>
          <ul>{report.methodology.scenarioTaxonomy.map((scenario) => <li>{scenario}</li>)}</ul>
        </details>
        <details>
          <summary>External foundations and adaptations</summary>
          <p>
            No source below defines or endorses Context Health Core 0.1. The experimental
            methodology adapts narrower ideas from each source.
          </p>
          <ul>
            {
              report.methodology.foundations.map((foundation) => (
                <li>
                  <a href={foundation.url}>{foundation.label}</a>: {foundation.adaptation}
                </li>
              ))
            }
          </ul>
        </details>
        <details>
          <summary>Report limitations</summary>
          <ul>{report.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
        </details>
      </section>
    </main>
  </body>
</html>
