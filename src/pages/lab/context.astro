---
/**
 * Context Lab — an interactive workbench for exploring context-quality metrics.
 *
 * This page is scoped to /lab/context/ and does not share modules, styles,
 * or scripts with the main blog layout.
 *
 * The analysis is an educational model. It does not measure actual agent
 * behavior or use any LLM, external API, or backend service.
 */
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Context Lab — Eric Carlisle</title>
    <meta
      name="description"
      content="An interactive educational model for exploring how context quality affects coding-agent behavior."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      /* ── Lab page layout ───────────────────────────────────────────── */
      .lab-page {
        max-width: var(--layout-rail-page);
        margin-inline: auto;
        padding: var(--space-layout) var(--space-component);
        font-family: var(--font-copy);
        color: var(--text-primary);
        line-height: var(--line-height-body);
      }

      .lab-page__heading {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        font-size: var(--type-size-h2);
        line-height: var(--line-height-h2);
        margin: 0 0 var(--space-xs);
        text-wrap: balance;
      }

      .lab-page__subtitle {
        color: var(--text-secondary);
        font-size: var(--type-size-body);
        max-width: var(--layout-rail-prose);
        margin: 0 0 var(--space-xl);
      }

      .lab-page__disclaimer {
        background: var(--bg-surface);
        border-left: var(--size-border-thick) solid var(--brand-highlight);
        padding: var(--space-component);
        border-radius: var(--radius-md);
        margin-bottom: var(--space-xl);
        font-size: var(--type-size-small);
        color: var(--text-secondary);
      }

      /* ── Steps ──────────────────────────────────────────────────────── */
      .step {
        margin-bottom: var(--space-xl);
      }

      .step__heading {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        font-size: var(--type-size-h4);
        line-height: var(--line-height-h4);
        margin: 0 0 var(--space-sm);
      }

      .step__hint {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        margin: 0 0 var(--space-sm);
      }

      .step__note {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        margin: var(--space-sm) 0 0;
        line-height: 1.5;
      }

      /* ── Task list (native radio) ────────────────────────────────────── */
      .task-list {
        border: none;
        padding: 0;
        margin: 0 0 var(--space-sm);
      }

      .task-list .step__heading {
        margin-bottom: var(--space-sm);
      }

      .task-list__item {
        display: flex;
        align-items: flex-start;
        gap: var(--space-sm);
        padding: var(--space-component);
        background: var(--color-card-bg);
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: border-color var(--transition-fast),
                    box-shadow var(--transition-fast);
        margin-bottom: var(--space-sm);
      }

      .task-list__item:hover {
        border-color: var(--color-link);
      }

      .task-list:has(:checked) .task-list__item:has(:not(:checked)) {
        opacity: 0.7;
      }

      .task-list__item:has(:checked) {
        border-color: var(--color-link);
        box-shadow: 0 0 0 1px var(--color-link);
      }

      .task-list__radio {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }

      .task-list__radio:focus-visible + .task-list__content {
        outline: var(--focus-outline-width) var(--focus-outline-style) var(--color-focus);
        outline-offset: var(--focus-outline-offset);
      }

      .task-list__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        flex: 1;
      }

      .task-list__item-title {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        font-size: var(--type-size-body);
      }

      .task-list__item-desc {
        font-size: var(--type-size-small);
        color: var(--text-secondary);
      }

      /* ── Preset list (native radio) ─────────────────────────────────── */
      .preset-list {
        border: none;
        padding: 0;
        margin: 0 0 var(--space-sm);
      }

      .preset-list .step__heading {
        margin-bottom: var(--space-sm);
      }

      .preset-list__item {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: flex-start;
        gap: var(--space-sm);
        padding: var(--space-component);
        background: var(--color-card-bg);
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: border-color var(--transition-fast),
                    box-shadow var(--transition-fast);
        margin-bottom: var(--space-sm);
      }

      .preset-list__item:hover {
        border-color: var(--color-link);
      }

      .preset-list:has(:checked) .preset-list__item:has(:not(:checked)) {
        opacity: 0.7;
      }

      .preset-list__item:has(:checked) {
        border-color: var(--color-link);
        box-shadow: 0 0 0 1px var(--color-link);
      }

      .preset-list__radio {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }

      .preset-list__radio:focus-visible + .preset-list__content {
        outline: var(--focus-outline-width) var(--focus-outline-style) var(--color-focus);
        outline-offset: var(--focus-outline-offset);
      }

      .preset-list__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        flex: 1;
      }

      @supports not selector(:has(*)) {
        .task-list__item--selected {
          border-color: var(--color-link);
          box-shadow: 0 0 0 1px var(--color-link);
        }
        .preset-list__item--selected {
          border-color: var(--color-link);
          box-shadow: 0 0 0 1px var(--color-link);
        }
      }

      /* ── Document list ──────────────────────────────────────────────── */
      .doc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .doc-list__item {
        margin: 0;
      }

      .doc-list__item--included {
        border-left: var(--size-border-thick) solid var(--color-link);
      }

      .doc-list__label {
        display: flex;
        align-items: flex-start;
        gap: var(--space-sm);
        padding: var(--space-component);
        background: var(--color-card-bg);
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: border-color var(--transition-fast);
      }

      .doc-list__label:hover {
        border-color: var(--color-link);
      }

      .doc-list__checkbox {
        margin-top: 0.2em;
        min-width: 18px;
        min-height: 18px;
        accent-color: var(--color-action);
      }

      .doc-list__info {
        display: flex;
        flex-direction: column;
        gap: 0.2em;
        flex: 1;
      }

      .doc-list__title {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        font-size: var(--type-size-body);
        color: var(--text-primary);
      }

      .doc-list__meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-inline);
        align-items: center;
        font-size: var(--type-size-small);
        color: var(--text-secondary);
      }

      .doc-list__badge {
        display: inline-block;
        padding: 0.1em 0.5em;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.85em;
        text-transform: uppercase;
      }

      .doc-list__badge--high {
        background: oklch(0.45 0.1 250);
        color: #fff;
      }

      .doc-list__badge--medium {
        background: oklch(0.5 0.06 260);
        color: #fff;
      }

      .doc-list__badge--low {
        background: oklch(0.4 0.02 260);
        color: var(--text-muted);
      }

      .doc-list__relevance {
        font-family: var(--font-mono);
        font-size: 0.85em;
        color: var(--text-muted);
      }

      .doc-list__relevance--relevant {
        color: var(--color-success);
      }

      /* ── Metrics grid ───────────────────────────────────────────────── */
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--space-component);
      }

      .metric-card {
        background: var(--color-card-bg);
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        padding: var(--space-component);
      }

      .metric-card__header {
        margin-bottom: var(--space-sm);
      }

      .metric-card__value {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
      }

      .metric-card__value--size {
        flex-wrap: wrap;
      }

      .metric-card__number {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-bold);
        font-size: var(--type-size-h3);
        line-height: 1;
        color: var(--color-link);
      }

      .metric-card__number--size {
        font-size: var(--type-size-body);
        font-family: var(--font-mono);
      }

      .metric-card__label--sub {
        font-size: var(--type-size-small);
        color: var(--text-muted);
      }

      .metric-card__bar {
        display: block;
        width: 100%;
        height: 8px;
        background: var(--bg-surface-elevated);
        border-radius: 4px;
        overflow: hidden;
        margin-top: var(--space-xs);
      }

      .metric-card__bar-fill {
        display: block;
        height: 100%;
        background: var(--color-link);
        border-radius: 4px;
        transition: width var(--transition-normal);
      }

      .metric-card__label {
        font-family: var(--font-headers);
        font-weight: var(--font-weight-medium);
        font-size: var(--type-size-body);
        margin: 0;
        color: var(--text-primary);
      }

      .metric-card__toggle {
        display: inline-block;
        background: none;
        border: none;
        color: var(--color-link);
        font-family: inherit;
        font-size: var(--type-size-small);
        cursor: pointer;
        padding: var(--space-xs) 0;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .metric-card__toggle:hover {
        color: var(--color-link-hover);
      }

      .metric-card__toggle:focus-visible {
        outline: var(--focus-outline-width) var(--focus-outline-style) var(--color-focus);
        outline-offset: var(--focus-outline-offset);
      }

      .metric-card__detail {
        margin-top: var(--space-sm);
        padding-top: var(--space-sm);
        border-top: var(--size-border-pixel) solid var(--border-muted);
      }

      .metric-card__explanation {
        font-size: var(--type-size-small);
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 var(--space-xs);
      }

      .metric-card__direction {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        font-family: var(--font-mono);
        margin: 0;
      }

      .metric-card__number--na {
        color: var(--text-muted);
        font-size: var(--type-size-h4);
      }

      .metric-card__na-note {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        font-style: italic;
        margin: 0 0 var(--space-xs);
      }

      .metric-card__docs {
        font-size: var(--type-size-small);
        color: var(--text-secondary);
        line-height: 1.5;
        margin: 0 0 var(--space-xs);
      }

      .metric-card__improve {
        font-size: var(--type-size-small);
        color: var(--brand-accent);
        line-height: 1.5;
        margin: var(--space-xs) 0 0;
        padding-top: var(--space-xs);
        border-top: var(--size-border-pixel) solid var(--border-muted);
      }

      .preset-list__item-count {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        font-family: var(--font-mono);
      }

      .doc-list__size {
        font-family: var(--font-mono);
        font-size: 0.85em;
        color: var(--text-muted);
      }

      /* ── Empty state ────────────────────────────────────────────────── */
      .empty-state {
        text-align: center;
        padding: var(--space-xl);
        color: var(--text-muted);
      }

      /* ── Responsive ─────────────────────────────────────────────────── */
      @media (max-width: 720px) {
        .lab-page {
          padding: var(--space-component);
        }

        .preset-list {
          flex-direction: column;
        }

        .preset-list__item {
          min-width: unset;
        }

        .metrics-grid {
          grid-template-columns: 1fr;
        }

        .doc-list__meta {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <main class="lab-page" data-pagefind-ignore="all">
      <h1 class="lab-page__heading">Context Lab</h1>
      <p class="lab-page__subtitle">
        An interactive workbench for exploring how context quality metrics behave.
        Select a task, choose a document preset, and toggle individual documents
        to see how each metric responds.
      </p>

      <aside class="lab-page__disclaimer" role="note">
        <strong>Educational model.</strong> These metrics approximate how well a
        set of context documents serves a task. They do not measure actual agent
        behavior, LLM output, or real-world context effectiveness. All calculations
        are deterministic and based on manually defined fixture data.
      </aside>

      <div class="experiment" id="app">
        <noscript>
          <div class="step">
            <p class="step__heading">Interactive experiment requires JavaScript</p>
            <p class="step__hint">
              The Context Lab is an interactive tool that evaluates context-quality
              metrics based on your document selections. Enable JavaScript to use
              the experiment controls, select tasks, toggle documents, and inspect
              metric explanations.
            </p>
          </div>
        </noscript>
        <div class="step" id="step-task" role="region" aria-label="Task selection">
          <!-- Rendered by controller -->
        </div>

        <div class="step" id="step-preset" role="region" aria-label="Preset selection">
          <!-- Rendered by controller -->
        </div>

        <div class="step" id="step-docs" role="region" aria-label="Document review">
          <!-- Rendered by controller -->
        </div>

        <div class="step" id="step-results" role="region" aria-label="Context quality metrics">
          <!-- Rendered by controller -->
        </div>
      </div>
    </main>

    <script>
      // --- Theme: apply stored preference before first paint ---
      // Matches the pattern used in BaseHead.astro's inline script.
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored) {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>

    <script>
      import { initialize } from '../../lab/context/controller';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initialize);
      } else {
        initialize();
      }
    </script>
  </body>
</html>
