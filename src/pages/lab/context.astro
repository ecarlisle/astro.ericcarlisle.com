---
import '../../styles/global.css';
import ContextCheckCard from '../../components/lab/ContextCheckCard.astro';

interface EvidenceCitation {
  path: string;
  section?: string;
  startLine?: number;
  endLine?: number;
}

interface ContextCheck {
  id: string;
  label: string;
  weight: number;
  result: 'pass' | 'partial' | 'fail';
  impact: 'positive' | 'negative';
  interpretation: string;
  contribution: number;
  evidence: {
    observation: string;
    citations: EvidenceCitation[];
  };
}

interface ContextMetric {
  id: string;
  label: string;
  score: number | null;
  status: 'healthy' | 'needs-attention' | 'at-risk';
  interpretation: string;
  assessmentType: 'deterministic' | 'agent-assessed';
  checks?: ContextCheck[];
  details?: {
    characters: number;
    estimatedTokens: number;
    estimationMethod: string;
    measuredFiles: Array<{ path: string; characters: number }>;
  };
}

interface ContextHealthReport {
  schemaVersion: string;
  auditedAt: string;
  repositoryRevision: string;
  effectiveContext: {
    name: string;
    selectionRule: string;
    files: string[];
  };
  overallSummary: string;
  strengths: string[];
  priorities: Array<{ priority: number; finding: string; recommendation: string }>;
  metrics: ContextMetric[];
  methodology: {
    scoreCalculation: string;
    assessmentBoundary: string;
    tokenEstimation: { formula: string; charactersPerToken: number; note: string };
    activeContextThresholds: string;
  };
  limitations: string[];
}

const report = (await import('../../data/context-health.json')).default as ContextHealthReport;

function statusClass(status: ContextMetric['status']) {
  return `ch-status--${status}`;
}

function statusLabel(status: ContextMetric['status']) {
  return {
    healthy: 'Healthy',
    'needs-attention': 'Needs attention',
    'at-risk': 'At risk',
  }[status];
}

function percentage(score: number | null) {
  return score === null ? '—' : `${Math.round(score * 100)}%`;
}

function formatNumber(value: number | undefined) {
  return value === undefined ? '—' : value.toLocaleString('en-US');
}

function metricDisplayValue(metric: ContextMetric) {
  return metric.id === 'active-context-size'
    ? `${formatNumber(metric.details?.characters)} chars`
    : percentage(metric.score);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Context Health: EricCarlisle.com</title>
    <meta
      name="description"
      content="A static, evidence-backed audit of the coding-agent context for EricCarlisle.com."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      .ch-page {
        max-width: var(--layout-rail-page);
        margin-inline: auto;
        padding: var(--space-layout) var(--space-component);
        color: var(--text-primary);
      }

      .ch-page__heading,
      .ch-section-heading,
      .ch-overview h3,
      .ch-methodology h3 {
        font-family: var(--font-headers);
      }

      .ch-page__heading {
        margin: 0 0 var(--space-xs);
        font-size: var(--type-size-h2);
        line-height: var(--line-height-h2);
        text-wrap: balance;
      }

      .ch-page__meta,
      .ch-score__type,
      .ch-check__weight,
      .ch-file-table {
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
      }

      .ch-page__meta {
        margin: 0 0 var(--space-xl);
        color: var(--text-muted);
      }

      .ch-page__disclaimer {
        margin-bottom: var(--space-section);
        padding: var(--space-component);
        border-left: var(--size-border-thick) solid var(--brand-highlight);
        border-radius: var(--radius-md);
        background: var(--bg-surface);
        color: var(--text-secondary);
        font-size: var(--type-size-small);
      }

      .ch-overview,
      .ch-scores,
      .ch-details {
        margin-bottom: var(--space-section);
      }

      .ch-overview__summary {
        max-width: var(--layout-rail-prose);
        margin: 0 0 var(--space-lg);
        font-size: var(--type-size-body);
        line-height: 1.6;
      }

      .ch-overview__columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-component-lg);
      }

      .ch-overview h3 {
        margin: 0 0 var(--space-sm);
        font-size: var(--type-size-h5);
      }

      .ch-overview ul,
      .ch-overview ol {
        margin: 0;
      }

      .ch-overview ul {
        padding: 0;
        list-style: none;
      }

      .ch-overview ol {
        padding-inline-start: var(--space-component-lg);
      }

      .ch-overview li {
        padding: var(--space-xs) 0;
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
        font-size: var(--type-size-small);
        line-height: 1.5;
      }

      .ch-overview li:last-child {
        border-bottom: 0;
      }

      .ch-priority__recommendation {
        display: block;
        margin-top: var(--space-xs);
        color: var(--brand-accent);
      }

      .ch-scores {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.75rem), 1fr));
        gap: var(--space-component);
      }

      .ch-score,
      .ch-details details {
        border: var(--size-border-pixel) solid var(--color-card-border);
        border-radius: var(--radius-md);
        background: var(--color-card-bg);
      }

      .ch-score {
        padding: var(--space-component);
      }

      .ch-score__value {
        margin-bottom: var(--space-xs);
        color: var(--color-link);
        font-family: var(--font-headers);
        font-size: var(--type-size-h3);
        font-weight: var(--font-weight-bold);
        line-height: 1;
      }

      .ch-score__value--size {
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: var(--type-size-body);
      }

      .ch-score__label {
        margin-bottom: var(--space-xs);
        font-family: var(--font-headers);
        font-weight: var(--font-weight-medium);
      }

      .ch-status {
        display: inline-block;
        margin-bottom: var(--space-xs);
        padding: 0.15em 0.55em;
        border-radius: var(--radius-sm);
        color: #fff;
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        font-weight: var(--font-weight-bold);
      }

      .ch-status--healthy {
        background: #126044;
      }

      .ch-status--needs-attention {
        background: #755400;
      }

      .ch-status--at-risk {
        background: #842c24;
      }

      .ch-score__interp,
      .ch-details__interp,
      .ch-methodology p,
      .ch-methodology li {
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.6;
      }

      .ch-score__interp {
        margin: 0;
      }

      .ch-score__type {
        margin-top: var(--space-xs);
        color: var(--text-muted);
      }

      .ch-section-heading {
        margin: 0 0 var(--space-component);
        font-size: var(--type-size-h4);
      }

      .ch-details details {
        margin-bottom: var(--space-component);
        padding: var(--space-component);
      }

      .ch-details summary {
        cursor: pointer;
        font-family: var(--font-headers);
        font-size: var(--type-size-h5);
        font-weight: var(--font-weight-bold);
        overflow-wrap: anywhere;
      }

      .ch-details summary:focus-visible {
        border-radius: var(--radius-sm);
        outline: var(--focus-outline-width) var(--focus-outline-style) var(--color-focus);
        outline-offset: var(--focus-outline-offset);
      }

      .ch-details details[open] summary {
        margin-bottom: var(--space-component);
        padding-bottom: var(--space-component);
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
      }

      .ch-details__interp {
        margin: 0 0 var(--space-component);
      }

      .ch-contributors {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-component);
      }

      .ch-contributor-group h3 {
        margin: 0 0 var(--space-sm);
        font-family: var(--font-headers);
        font-size: var(--type-size-body);
      }

      .ch-check {
        margin-bottom: var(--space-sm);
        padding: var(--space-sm);
        border-left: var(--size-border-thick) solid var(--border-main);
        border-radius: var(--radius-md);
        background: var(--bg-surface-elevated);
      }

      .ch-check--positive {
        border-left-color: var(--color-success);
      }

      .ch-check--negative {
        border-left-color: var(--brand-highlight);
      }

      .ch-check__header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
        font-size: var(--type-size-small);
      }

      .ch-check__label {
        color: var(--text-primary);
        font-weight: var(--font-weight-bold);
      }

      .ch-check__result {
        flex: none;
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-weight: var(--font-weight-bold);
      }

      .ch-check__evidence,
      .ch-check__interpretation {
        margin: var(--space-xs) 0 0;
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.5;
      }

      .ch-check__citations {
        margin: var(--space-xs) 0 0;
        padding-left: var(--space-component);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        overflow-wrap: anywhere;
      }

      .ch-check__weight {
        margin-top: var(--space-xs);
        color: var(--text-muted);
      }

      .ch-size-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-component);
        margin-bottom: var(--space-component);
      }

      .ch-size-stat {
        padding: var(--space-component);
        border-radius: var(--radius-md);
        background: var(--bg-surface-elevated);
        text-align: center;
      }

      .ch-size-stat__value {
        color: var(--color-link);
        font-family: var(--font-headers);
        font-size: var(--type-size-h3);
        font-weight: var(--font-weight-bold);
        line-height: 1;
      }

      .ch-size-stat__label {
        margin-top: var(--space-xs);
        color: var(--text-muted);
        font-size: var(--type-size-small);
      }

      .ch-size-note {
        color: var(--text-secondary);
        font-size: var(--type-size-small);
      }

      .ch-file-table-wrap {
        max-width: 100%;
        overflow-x: auto;
      }

      .ch-file-table {
        width: 100%;
        border-collapse: collapse;
      }

      .ch-file-table th,
      .ch-file-table td {
        padding: var(--space-xs) var(--space-inline);
        border-bottom: var(--size-border-pixel) solid var(--border-muted);
        text-align: left;
      }

      .ch-file-table th {
        color: var(--text-primary);
        font-family: var(--font-headers);
      }

      .ch-file-table td {
        color: var(--text-secondary);
        overflow-wrap: anywhere;
      }

      .ch-file-table th:last-child,
      .ch-file-table td:last-child {
        text-align: right;
        white-space: nowrap;
      }

      .ch-methodology {
        padding-top: var(--space-section);
        border-top: var(--size-border-pixel) solid var(--border-main);
      }

      .ch-methodology h3 {
        margin: var(--space-component) 0 var(--space-sm);
        font-size: var(--type-size-body);
      }

      .ch-methodology p,
      .ch-methodology li {
        max-width: var(--layout-rail-prose);
      }

      @media (max-width: 720px) {
        .ch-overview__columns,
        .ch-contributors,
        .ch-size-grid {
          grid-template-columns: 1fr;
        }

        .ch-check__header {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="ch-page" data-pagefind-ignore="all">
      <h1 class="ch-page__heading">Context Health: EricCarlisle.com</h1>
      <p class="ch-page__meta">
        Audited {report.auditedAt} · Audited repository revision {report.repositoryRevision} · Schema
        v{report.schemaVersion}
      </p>

      <aside class="ch-page__disclaimer">
        <strong>Context structure audit, not an LLM evaluation.</strong> Deterministic values are
        generated from the declared file set. Semantic findings are explicitly agent-assessed.
      </aside>

      <section class="ch-overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="ch-section-heading">Overview</h2>
        <p class="ch-overview__summary">{report.overallSummary}</p>
        <div class="ch-overview__columns">
          <div>
            <h3>Key strengths</h3>
            <ul>
              {report.strengths.map((strength) => <li>{strength}</li>)}
            </ul>
          </div>
          <div>
            <h3>Prioritized improvements</h3>
            <ol>
              {
                report.priorities.map((priority) => (
                  <li>
                    <strong>{priority.finding}</strong>
                    <span class="ch-priority__recommendation">{priority.recommendation}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section aria-labelledby="scores-heading">
        <h2 id="scores-heading" class="ch-section-heading">Current metrics</h2>
        <div class="ch-scores">
          {
            report.metrics.map((metric) => (
              <article class="ch-score">
                <div
                  class:list={[
                    'ch-score__value',
                    metric.id === 'active-context-size' && 'ch-score__value--size',
                  ]}
                >
                  {metricDisplayValue(metric)}
                </div>
                <h3 class="ch-score__label">{metric.label}</h3>
                <div class:list={['ch-status', statusClass(metric.status)]}>
                  {statusLabel(metric.status)}
                </div>
                <p class="ch-score__interp">{metric.interpretation}</p>
                <div class="ch-score__type">
                  {metric.assessmentType === 'deterministic' ? 'Deterministic' : 'Agent-assessed'}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="ch-details" aria-labelledby="details-heading">
        <h2 id="details-heading" class="ch-section-heading">Detailed findings</h2>
        {
          report.metrics.map((metric) => {
            const positive = metric.checks?.filter((check) => check.impact === 'positive') ?? [];
            const negative = metric.checks?.filter((check) => check.impact === 'negative') ?? [];
            return (
              <details>
                <summary>
                  {metric.label}: {metricDisplayValue(metric)}
                </summary>
                <p class="ch-details__interp">{metric.interpretation}</p>

                {metric.checks && (
                  <div class="ch-contributors">
                    {positive.length > 0 && (
                      <section class="ch-contributor-group" aria-label={`${metric.label} positives`}>
                        <h3>Positive contributors</h3>
                        {positive.map((check) => (
                          <ContextCheckCard
                            check={check}
                            repositoryRevision={report.repositoryRevision}
                          />
                        ))}
                      </section>
                    )}
                    {negative.length > 0 && (
                      <section class="ch-contributor-group" aria-label={`${metric.label} negatives`}>
                        <h3>Negative contributors</h3>
                        {negative.map((check) => (
                          <ContextCheckCard
                            check={check}
                            repositoryRevision={report.repositoryRevision}
                          />
                        ))}
                      </section>
                    )}
                  </div>
                )}

                {metric.details && (
                  <div>
                    <div class="ch-size-grid">
                      <div class="ch-size-stat">
                        <div class="ch-size-stat__value">
                          {formatNumber(metric.details.characters)}
                        </div>
                        <div class="ch-size-stat__label">Characters</div>
                      </div>
                      <div class="ch-size-stat">
                        <div class="ch-size-stat__value">
                          ~{formatNumber(metric.details.estimatedTokens)}
                        </div>
                        <div class="ch-size-stat__label">Estimated tokens</div>
                      </div>
                    </div>
                    <p class="ch-size-note">
                      <strong>{report.effectiveContext.name}:</strong>{' '}
                      {report.effectiveContext.selectionRule}
                    </p>
                    <p class="ch-size-note">{metric.details.estimationMethod}</p>
                    <div class="ch-file-table-wrap">
                      <table class="ch-file-table">
                        <thead>
                          <tr>
                            <th scope="col">Declared file</th>
                            <th scope="col">Characters</th>
                          </tr>
                        </thead>
                        <tbody>
                          {metric.details.measuredFiles.map((file) => (
                            <tr>
                              <td>{file.path}</td>
                              <td>{formatNumber(file.characters)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </details>
            );
          })
        }
      </section>

      <section class="ch-methodology" aria-labelledby="methodology-heading">
        <h2 id="methodology-heading" class="ch-section-heading">Methodology</h2>
        <p>{report.methodology.scoreCalculation}</p>
        <p>{report.methodology.assessmentBoundary}</p>
        <p>
          Token estimate: {report.methodology.tokenEstimation.formula}.{' '}
          {report.methodology.tokenEstimation.note}
        </p>
        <p>{report.methodology.activeContextThresholds}</p>
        <h3>Limitations</h3>
        <ul>
          {report.limitations.map((limitation) => <li>{limitation}</li>)}
        </ul>
      </section>
    </main>
  </body>
</html>
