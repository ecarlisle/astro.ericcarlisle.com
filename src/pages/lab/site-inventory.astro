---
import '../../styles/global.css';

interface Warning {
  code: string;
  message: string;
}

interface PageEntry {
  route: string;
  file: string | null;
  size: number | null;
  built: boolean;
  inSitemap: boolean;
  sitemapLastmod: string | null;
  title: string | null;
  description: string | null;
  canonical: string | null;
  robots: string | null;
  h1Count: number;
  h1Texts: string[];
  inboundCount: number;
  warnings: Warning[];
}

interface InventoryData {
  generatedAt: string;
  summary: {
    totalUrls: number;
    builtPages: number;
    sitemapUrls: number;
    orphanedPages: number;
    pagesWithWarnings: number;
    totalWarnings: number;
  };
  pages: PageEntry[];
}

let data: InventoryData | null = null;
let loadError: string | null = null;
try {
  data = (await import('../../generated/site-inventory.json')).default;
} catch (e) {
  loadError =
    'Inventory data not found. Run the production build and site-inventory generator first.';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Site Inventory — Eric Carlisle</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/_astro/global.*.css" />
    <style>
      .si-page {
        max-width: var(--layout-rail-page, 72rem);
        margin: var(--space-layout) auto;
        padding: 0 var(--space-component);
        font-family: var(--font-copy);
        color: var(--text-primary);
      }
      .si-page h1 {
        font-family: var(--font-headers);
        font-size: var(--type-size-h2);
        margin: 0 0 var(--space-xs);
      }
      .si-page__meta {
        color: var(--text-muted);
        font-size: var(--type-size-small);
        font-family: var(--font-mono);
        margin: 0 0 var(--space-lg);
      }
      .si-page__explainer {
        max-width: var(--layout-rail-prose);
        color: var(--text-secondary);
        font-size: var(--type-size-small);
        line-height: 1.6;
        margin-bottom: var(--space-lg);
        padding: var(--space-component);
        background: var(--bg-surface);
        border-left: 3px solid var(--brand-primary);
        border-radius: var(--radius-md);
      }
      .si-summary {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-component);
        margin-bottom: var(--space-lg);
      }
      .si-stat {
        padding: var(--space-component);
        background: var(--bg-surface);
        border: 1px solid var(--border-muted);
        border-radius: var(--radius-md);
        text-align: center;
        flex: 1;
        min-width: 100px;
      }
      .si-stat__value {
        font-family: var(--font-mono);
        font-size: var(--type-size-h3);
        font-weight: var(--font-weight-bold);
        color: var(--text-primary);
        line-height: 1.2;
      }
      .si-stat__value--warn {
        color: var(--brand-highlight);
      }
      .si-stat__label {
        font-size: var(--type-size-small);
        color: var(--text-muted);
        margin-top: var(--space-xs);
      }
      .si-controls {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        margin-bottom: var(--space-component);
        align-items: center;
      }
      .si-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
      }
      .si-filter-btn {
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        padding: var(--space-xs) var(--space-sm);
        border: 1px solid var(--border-control);
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all var(--transition-fast);
      }
      .si-filter-btn:hover {
        border-color: var(--color-link);
        color: var(--color-link);
      }
      .si-filter-btn--active {
        background: var(--color-link);
        color: var(--bg-main);
        border-color: var(--color-link);
      }
      .si-search {
        font-family: var(--font-mono);
        font-size: var(--type-size-small);
        padding: var(--space-xs) var(--space-sm);
        border: 1px solid var(--border-control);
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
        color: var(--text-primary);
        flex: 1;
        min-width: 200px;
      }
      .si-search:focus {
        outline: 2px dashed var(--color-focus);
        outline-offset: 2px;
      }
      .si-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border-muted);
        border-radius: var(--radius-md);
      }
      .si-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--type-size-small);
      }
      .si-table th {
        background: var(--bg-surface);
        color: var(--text-muted);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
        padding: var(--space-sm) var(--space-inline);
        text-align: left;
        white-space: nowrap;
        border-bottom: 2px solid var(--border-main);
        position: sticky;
        top: 0;
      }
      .si-table td {
        padding: var(--space-sm) var(--space-inline);
        border-bottom: 1px solid var(--border-muted);
        vertical-align: top;
      }
      .si-row--warn {
        background: color-mix(in srgb, var(--brand-highlight) 8%, transparent);
      }
      .si-row--warn:hover {
        background: color-mix(in srgb, var(--brand-highlight) 14%, transparent);
      }
      .si-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75em;
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        font-weight: var(--font-weight-bold);
      }
      .si-badge--ok {
        background: color-mix(in srgb, var(--brand-accent) 15%, transparent);
        color: var(--brand-accent);
      }
      .si-badge--warn {
        background: color-mix(in srgb, var(--brand-highlight) 20%, transparent);
        color: var(--brand-highlight);
      }
      .si-badge--missing {
        background: color-mix(in srgb, #ef4444 15%, transparent);
        color: #ef4444;
      }
      .si-warn-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .si-warn-list li {
        margin-bottom: 2px;
        font-size: 0.9em;
      }
      .si-warn-code {
        font-family: var(--font-mono);
        font-size: 0.85em;
        color: var(--brand-highlight);
      }
      .si-route-link {
        color: var(--color-link);
        text-decoration: none;
        font-family: var(--font-mono);
      }
      .si-route-link:hover {
        text-decoration: underline;
      }
      .si-details-toggle {
        color: var(--text-muted);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: none;
        border: none;
        padding: 0;
      }
      .si-details-toggle:hover {
        color: var(--color-link);
      }
      .si-details {
        margin-top: var(--space-xs);
        color: var(--text-muted);
        font-size: 0.9em;
      }
      .si-details dt {
        font-weight: var(--font-weight-bold);
        color: var(--text-secondary);
        margin-top: var(--space-xs);
      }
      .si-details dd {
        margin: 0;
      }
      .si-empty {
        text-align: center;
        padding: var(--space-xl);
        color: var(--text-muted);
      }
      .si-error {
        text-align: center;
        padding: var(--space-xl);
        color: #ef4444;
      }
      .si-404-link {
        display: inline-block;
        margin-top: var(--space-sm);
      }
      @media (max-width: 720px) {
        .si-summary {
          gap: var(--space-sm);
        }
        .si-stat {
          min-width: calc(50% - var(--space-sm));
        }
        .si-controls {
          flex-direction: column;
          align-items: stretch;
        }
        .si-filter-group {
          justify-content: center;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .si-filter-btn {
          transition: none;
        }
      }
    </style>
  </head>
  <body data-pagefind-ignore="all">
    <div class="si-page">
      <h1>Site Inventory</h1>
      <p class="si-page__meta">Build audit · generated data</p>

      <div class="si-page__explainer">
        <strong>What this is:</strong> A post-build inventory that cross-references
        generated HTML pages, the XML sitemap, and internal links to find missing
        or inconsistent metadata, orphaned pages, and sitemap discrepancies.
        This is a developer tool — it does not measure live availability,
        search indexing, or Core Web Vitals. See
        <a href="/portfolio/site-quality/">Site Quality</a> for Lighthouse scores
        and performance measurements.
      </div>

      {
        loadError ? (
          <div class="si-error">
            <p>{loadError}</p>
            <p>Run <code>pnpm build && node scripts/generate-site-inventory.mjs</code> to generate the inventory.</p>
          </div>
        ) : data ? (
          <>
            <!-- Summary -->
            <div class="si-summary">
              <div class="si-stat">
                <div class="si-stat__value">{data.summary.totalUrls}</div>
                <div class="si-stat__label">Total URLs</div>
              </div>
              <div class="si-stat">
                <div class="si-stat__value">{data.summary.builtPages}</div>
                <div class="si-stat__label">Built pages</div>
              </div>
              <div class="si-stat">
                <div class="si-stat__value">{data.summary.sitemapUrls}</div>
                <div class="si-stat__label">Sitemap URLs</div>
              </div>
              <div class="si-stat">
                <div class="si-stat__value">{data.summary.orphanedPages}</div>
                <div class="si-stat__label">Orphaned pages</div>
                <div class="si-page__meta">No internal links</div>
              </div>
              <div class="si-stat">
                <div class={`si-stat__value ${data.summary.pagesWithWarnings > 0 ? 'si-stat__value--warn' : ''}`}>{data.summary.pagesWithWarnings}</div>
                <div class="si-stat__label">Pages with warnings</div>
              </div>
            </div>

            <!-- Controls -->
            <div class="si-controls">
              <div class="si-filter-group" role="group" aria-label="Filter inventory">
                <button class="si-filter-btn si-filter-btn--active" data-filter="all" type="button">All</button>
                <button class="si-filter-btn" data-filter="warnings" type="button">Warnings</button>
                <button class="si-filter-btn" data-filter="missing-sitemap" type="button">Missing from sitemap</button>
                <button class="si-filter-btn" data-filter="missing-page" type="button">No built page</button>
                <button class="si-filter-btn" data-filter="orphaned" type="button">Orphaned</button>
                <button class="si-filter-btn" data-filter="noindex" type="button">Noindex</button>
              </div>
              <input class="si-search" type="search" placeholder="Filter by route…" aria-label="Filter by URL route" />
            </div>

            <!-- Table -->
            <div class="si-table-wrap">
              <table class="si-table" id="inventory-table">
                <thead>
                  <tr>
                    <th>Route</th>
                    <th>Built</th>
                    <th>Sitemap</th>
                    <th>Title</th>
                    <th>H1</th>
                    <th>Links in</th>
                    <th>Warnings</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="inventory-body">
                  {data.pages.map((page) => (
                    <tr class={page.warnings.length > 0 ? 'si-row--warn' : ''} data-route={page.route}>
                      <td>
                        {page.built ? (
                          <a href={page.route} class="si-route-link">{page.route}</a>
                        ) : (
                          <span class="si-route-link" style="color:var(--text-muted)">{page.route}</span>
                        )}
                      </td>
                      <td>
                        {page.built
                          ? <span class="si-badge si-badge--ok">Yes</span>
                          : <span class="si-badge si-badge--missing">No</span>}
                      </td>
                      <td>
                        {page.inSitemap
                          ? <span class="si-badge si-badge--ok">Yes</span>
                          : <span class="si-badge si-badge--warn">No</span>}
                      </td>
                      <td>{page.title ?? <span style="color:var(--text-muted)">—</span>}</td>
                      <td>
                        {page.h1Count > 0
                          ? <span title={page.h1Texts.join(' | ')}>{page.h1Count}</span>
                          : <span style="color:var(--text-muted)">—</span>}
                      </td>
                      <td>{page.inboundCount}</td>
                      <td>
                        {page.warnings.length > 0 ? (
                          <ul class="si-warn-list">
                            {page.warnings.slice(0, 3).map((w) => (
                              <li><span class="si-warn-code">[{w.code}]</span> {w.message}</li>
                            ))}
                            {page.warnings.length > 3 && (
                              <li>… and {page.warnings.length - 3} more</li>
                            )}
                          </ul>
                        ) : (
                          <span style="color:var(--text-muted)">—</span>
                        )}
                      </td>
                      <td>
                        {page.description || page.canonical || page.robots ? (
                          <>
                            <button class="si-details-toggle" type="button" aria-expanded="false" data-toggle={page.route}>Details</button>
                            <div class="si-details" id={`details-${page.route}`} hidden>
                              {page.canonical && <><dt>Canonical</dt><dd>{page.canonical}</dd></>}
                              {page.description && <><dt>Description</dt><dd>{page.description}</dd></>}
                              {page.robots && <><dt>Robots</dt><dd>{page.robots}</dd></>}
                              {page.sitemapLastmod && <><dt>Last modified</dt><dd>{page.sitemapLastmod}</dd></>}
                              {page.size && <><dt>Size</dt><dd>{page.size} bytes</dd></>}
                              {page.file && <><dt>File</dt><dd>{page.file}</dd></>}
                            </div>
                          </>
                        ) : null}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {data.pages.length === 0 && (
              <div class="si-empty">No pages found.</div>
            )}

            <script>
              (function() {
                var table = document.getElementById('inventory-table');
                var body = document.getElementById('inventory-body');
                var searchInput = document.querySelector('.si-search');
                var filterBtns = document.querySelectorAll('.si-filter-btn');
                if (!body) return;

                var allRows = Array.from(body.querySelectorAll('tr'));
                var activeFilter = 'all';

                function applyFilter() {
                  var query = (searchInput ? (searchInput as HTMLInputElement).value.toLowerCase() : '');
                  allRows.forEach(function(row) {
                    var route = row.getAttribute('data-route') || '';
                    var warnings = row.querySelector('.si-warn-list');
                    var built = row.querySelector('.si-badge--ok') !== null;
                    var inSitemap = false;
                    var sitemapCell = row.cells ? row.cells[2] : null;
                    if (sitemapCell) inSitemap = sitemapCell.textContent.trim() === 'Yes';
                    var noindex = false;
                    var detailsDiv = row.querySelector('.si-details');
                    if (detailsDiv && detailsDiv.textContent.indexOf('noindex') >= 0) noindex = true;
                    var orphaned = row.cells ? (parseInt(row.cells[5].textContent, 10) === 0 && built) : false;
                    var hasWarnings = warnings !== null;

                    // Filter by category
                    var show = true;
                    if (activeFilter === 'warnings') show = hasWarnings;
                    else if (activeFilter === 'missing-sitemap') show = built && !inSitemap;
                    else if (activeFilter === 'missing-page') show = !built;
                    else if (activeFilter === 'orphaned') show = orphaned;
                    else if (activeFilter === 'noindex') show = noindex;

                    // Filter by search query
                    if (show && query) {
                      show = route.indexOf(query) >= 0;
                    }

                    row.style.display = show ? '' : 'none';
                  });
                }

                // Search input
                if (searchInput) {
                  searchInput.addEventListener('input', applyFilter);
                }

                // Filter buttons
                filterBtns.forEach(function(btn) {
                  btn.addEventListener('click', function() {
                    filterBtns.forEach(function(b) { b.classList.remove('si-filter-btn--active'); });
                    btn.classList.add('si-filter-btn--active');
                    activeFilter = btn.getAttribute('data-filter') || 'all';
                    applyFilter();
                  });
                });

                // Details toggles
                body.addEventListener('click', function(e: MouseEvent) {
                  var toggle = (e.target as HTMLElement).closest('.si-details-toggle');
                  if (!toggle) return;
                  var details = toggle.parentElement ? toggle.parentElement.querySelector('.si-details') : null;
                  if (!details) return;
                  var expanded = toggle.getAttribute('aria-expanded') === 'true';
                  toggle.setAttribute('aria-expanded', String(!expanded));
                  (details as HTMLElement).hidden = expanded;
                });
              })();
            </script>
          </>
        ) : null
      }
    </div>
  </body>
</html>
