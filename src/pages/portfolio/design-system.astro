---
import Card from '../../components/Card.astro';
import HeaderLink from '../../components/HeaderLink.astro';
import PaginationNav from '../../components/PaginationNav.astro';
import ShareStrip from '../../components/ShareStrip.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { AUTHOR_NAME } from '../../consts';
import Layout from '../../layouts/BlogPost.astro';

const title = 'Design System Companion';
const description =
  'A curated reference for the typography, spacing, color, layout, components, and accessibility decisions implemented across ericcarlisle.com.';
const pageUrl = 'https://ericcarlisle.com/portfolio/design-system/';

const sampleDate = new Date('2024-06-15');
const sampleTags = ['Astro', 'CSS', 'Accessibility'];

const tagData = {
  allTags: ['Astro', 'CSS', 'Accessibility', 'Performance'],
  tagCounts: {
    Astro: 3,
    CSS: 5,
    Accessibility: 2,
    Performance: 1,
  },
};

const colorTokens = [
  { token: '--bg-main', dark: '#0b1020', light: '#f8fafc', usage: 'Page background' },
  { token: '--bg-surface', dark: '#111a2e', light: '#ffffff', usage: 'Cards, header, code blocks' },
  {
    token: '--bg-surface-elevated',
    dark: '#18243a',
    light: '#e8eef7',
    usage: 'Elevated surfaces, hover states',
  },
  { token: '--text-primary', dark: '#f8fafc', light: '#0f172a', usage: 'Headings, primary text' },
  {
    token: '--text-secondary',
    dark: '#cbd5e1',
    light: '#334155',
    usage: 'Body text, descriptions',
  },
  { token: '--text-muted', dark: '#94a3b8', light: '#475569', usage: 'Meta, captions, labels' },
  { token: '--brand-primary', dark: '#5ea8ff', light: '#005fcc', usage: 'Links, actions, focus' },
  {
    token: '--brand-accent',
    dark: '#38d9a9',
    light: '#007a5a',
    usage: 'Link hover, success states',
  },
  { token: '--brand-highlight', dark: '#ffb86b', light: '#a14b00', usage: 'Highlights, marks' },
  { token: '--border-main', dark: '#26344d', light: '#cbd5e1', usage: 'Card borders, dividers' },
  {
    token: '--border-muted',
    dark: '#1a2638',
    light: '#e2e8f0',
    usage: 'Header border, subtle separators',
  },
  { token: '--border-control', dark: '#52627a', light: '#64748b', usage: 'Form input borders' },
];

const semanticColors = [
  { token: '--color-link', usage: 'Default links', darkSource: '--brand-primary' },
  { token: '--color-link-hover', usage: 'Hovered links', darkSource: '--brand-accent' },
  { token: '--color-action', usage: 'Buttons, CTAs', darkSource: '--brand-primary' },
  { token: '--color-action-hover', usage: 'Button hover', darkSource: '#3d8ee0' },
  { token: '--color-focus', usage: 'Focus outlines', darkSource: '--color-link' },
  { token: '--color-success', usage: 'Success states', darkSource: '--brand-accent' },
  { token: '--color-card-bg', usage: 'Card backgrounds', darkSource: '--bg-surface' },
  {
    token: '--color-card-bg-elevated',
    usage: 'Elevated card backgrounds',
    darkSource: '--bg-surface-elevated',
  },
  { token: '--color-card-border', usage: 'Card borders', darkSource: '--border-main' },
];

const spacingTokens = [
  { token: '--space-xs', value: 'calc(var(--rhythm) * 0.5)', mobile: '13 px', desktop: '17 px' },
  { token: '--space-sm', value: 'calc(var(--rhythm) * 0.75)', mobile: '20 px', desktop: '25 px' },
  { token: '--space-md', value: 'var(--rhythm)', mobile: '26 px', desktop: '33 px' },
  { token: '--space-lg', value: 'calc(var(--rhythm) * 1.5)', mobile: '40 px', desktop: '50 px' },
  { token: '--space-xl', value: 'calc(var(--rhythm) * 2)', mobile: '53 px', desktop: '66 px' },
  {
    token: '--space-section',
    value: 'calc(var(--rhythm) * 2.5)',
    mobile: '66 px',
    desktop: '83 px',
  },
  { token: '--space-layout', value: 'calc(var(--rhythm) * 3)', mobile: '79 px', desktop: '99 px' },
];

const typeTokens = [
  { token: '--type-size-h1', mobile: '32 px', desktop: '64 px', lineHeight: '--line-height-h1' },
  { token: '--type-size-h2', mobile: '26 px', desktop: '45 px', lineHeight: '--line-height-h2' },
  { token: '--type-size-h3', mobile: '22 px', desktop: '32 px', lineHeight: '--line-height-h3' },
  { token: '--type-size-h4', mobile: '18 px', desktop: '24 px', lineHeight: '--line-height-h4' },
  { token: '--type-size-h5', mobile: '16 px', desktop: '19 px', lineHeight: '--line-height-h5' },
  {
    token: '--type-size-large',
    mobile: '18 px',
    desktop: '22 px',
    lineHeight: '--line-height-body',
  },
  {
    token: '--type-size-body',
    mobile: '16 px',
    desktop: '18 px',
    lineHeight: '--line-height-body',
  },
  {
    token: '--type-size-small',
    mobile: '13 px',
    desktop: '15 px',
    lineHeight: '--line-height-body',
  },
];

const knownGaps = [
  {
    item: 'Header height',
    note: 'Measured at runtime by JavaScript; the CSS fallback is 4.5rem.',
  },
  {
    item: 'Pagefind search UI',
    note: 'Third-party markup restyled by src/styles/pagefind.css.',
  },
  {
    item: 'Portfolio case-study grid',
    note: 'Page-local 1.6fr / 0.8fr sizing in src/pages/portfolio.astro.',
  },
  {
    item: 'Homepage role text',
    note: 'One-off letter-spacing on the homepage hero role; not tokenized.',
  },
  {
    item: 'Page-specific animations',
    note: 'Scroll-driven header behavior and card entrance motion are scoped to specific pages.',
  },
];
---

<Layout
  title={title}
  {description}
  pageType="portfolio"
  robots="noindex, follow"
>
<div data-pagefind-ignore>
  <div class="ds-hero">
    <p class="ds-hero-subtitle">Astro design system reference</p>
    <div class="ds-hero-meta">
      <span class="ds-hero-badge">Astro + vanilla CSS</span>
      <span class="ds-hero-badge">Living reference</span>
      <span class="ds-hero-badge">
        Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </span>
    </div>
  </div>

  <section class="ds-section">
    <h2>Overview</h2>
    <p>
      This page documents the design system implemented across the site. The
      CSS custom properties, components, and layout patterns shown here are the
      source of truth; the page renders and explains what is already in
      production.
    </p>
    <p>
      It is intended as a personal reference and may later be shared with
      interviewers or hiring managers as a portfolio artifact.
    </p>
  </section>

  <section class="ds-section">
    <h2>Design Principles</h2>
    <div class="ds-principles">
      <div class="ds-principle">
        <strong>Performance first</strong>
        <span>Static output, minimal JavaScript, no global bundles for page-specific features.</span>
      </div>
      <div class="ds-principle">
        <strong>Minimal JavaScript</strong>
        <span>Prefer Astro, HTML, and CSS before adding client-side behavior.</span>
      </div>
      <div class="ds-principle">
        <strong>Semantic HTML</strong>
        <span>Native elements before ARIA; correct heading order; one h1 per page.</span>
      </div>
      <div class="ds-principle">
        <strong>Accessibility</strong>
        <span>Keyboard, visible focus, contrast, reduced motion, and touch targets.</span>
      </div>
      <div class="ds-principle">
        <strong>Fluid responsive design</strong>
        <span>clamp() tokens for type and spacing; mobile-first breakpoints.</span>
      </div>
      <div class="ds-principle">
        <strong>Content-first layout</strong>
        <span>Readable measure, generous whitespace, clear visual hierarchy.</span>
      </div>
    </div>
  </section>

  <section class="ds-section">
    <h2>Typography</h2>
    <p>
      Headings use <code>var(--font-headers)</code>; body copy uses
      <code>var(--font-copy)</code>; monospace elements use
      <code>var(--font-mono)</code>.
    </p>

    <h3>Visual scale</h3>
    <div class="ds-type-stack">
      <div class="ds-type-sample ds-h1">Heading 1</div>
      <div class="ds-type-sample ds-h2">Heading 2</div>
      <div class="ds-type-sample ds-h3">Heading 3</div>
      <div class="ds-type-sample ds-h4">Heading 4</div>
      <div class="ds-type-sample ds-h5">Heading 5</div>
      <div class="ds-type-sample ds-body">
        Body text with a <a href="#">sample link</a> and <code>inline code</code>.
      </div>
      <div class="ds-type-sample ds-small">Small text for meta, captions, and labels.</div>
    </div>

    <h3>Token usage</h3>
    <table class="ds-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Mobile</th>
          <th scope="col">Desktop</th>
          <th scope="col">Line height</th>
        </tr>
      </thead>
      <tbody>
        {
          typeTokens.map(({ token, mobile, desktop, lineHeight }) => (
            <tr>
              <td><code>{token}</code></td>
              <td>{mobile}</td>
              <td>{desktop}</td>
              <td><code>{lineHeight}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3>Content samples</h3>
    <blockquote>
      Blockquotes use a left border and slightly larger text. This is how a pull
      quote or emphasized statement appears.
    </blockquote>

    <pre><code>/* Example token usage */
.card {'{'}
  padding: var(--space-component);
  background: var(--color-card-bg);
  border-radius: var(--radius-lg);
{'}'}</code></pre>
  </section>

  <section class="ds-section">
    <h2>Color Tokens</h2>
    <p>
      The default theme is dark. A light theme is applied via
      <code>[data-theme="light"]</code> or system preference.
    </p>

    <h3>Core palette</h3>
    <div class="ds-color-grid">
      {
        colorTokens.map(({ token, dark, light, usage }) => (
          <div class="ds-color-card">
            <div class="ds-color-swatch" style={`background: var(${token});`} />
            <div class="ds-color-info">
              <code>{token}</code>
              <span class="ds-color-usage">{usage}</span>
              <span class="ds-color-modes">Dark: {dark} / Light: {light}</span>
            </div>
          </div>
        ))
      }
    </div>

    <h3>Semantic roles</h3>
    <table class="ds-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Usage</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          semanticColors.map(({ token, usage, darkSource }) => (
            <tr>
              <td><code>{token}</code></td>
              <td>{usage}</td>
              <td><code>{darkSource}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="ds-section">
    <h2>Spacing Scale</h2>
    <p>
      Spacing is derived from the fluid rhythm token <code>var(--rhythm)</code>
      (≈ 26 px on mobile, ≈ 33 px on desktop).
    </p>
    <div class="ds-spacing-table">
      {
        spacingTokens.map(({ token, value, mobile, desktop }) => (
          <div class="ds-spacing-row">
            <div class="ds-spacing-label">
              <code>{token}</code>
              <span>{value}</span>
              <span class="ds-spacing-px">{mobile} → {desktop}</span>
            </div>
            <div class="ds-spacing-bar" style={`width: var(${token});`} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="ds-section">
    <h2>Layout Rails</h2>
    <p>
      Reading width and page width are intentionally separate. Prose stays narrow
      for readability, while pages and wide components can use more viewport
      space.
    </p>
    <div class="ds-rail-diagram">
      <div class="ds-rail-bar ds-rail-prose">
        <span>.rail--prose</span>
        <span>68ch — readable measure</span>
      </div>
      <div class="ds-rail-bar ds-rail-page">
        <span>.rail--page</span>
        <span>72rem — default page max</span>
      </div>
      <div class="ds-rail-bar ds-rail-wide">
        <span>.rail--wide</span>
        <span>80rem — wide layouts</span>
      </div>
    </div>
  </section>

  <section class="ds-section">
    <h2>Components</h2>

    <h3>Navigation</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4>HeaderLink</h4>
        <p class="ds-source">src/components/HeaderLink.astro</p>
        <div class="demo-row">
          <HeaderLink href="/portfolio/design-system">Active</HeaderLink>
          <HeaderLink href="/blog">Inactive</HeaderLink>
        </div>
      </div>
      <div class="ds-component-demo">
        <h4>Back link</h4>
        <p class="ds-source">src/styles/components.css</p>
        <a href="/portfolio" class="back-link">← Back to portfolio</a>
      </div>
      <div class="ds-component-demo">
        <h4>PaginationNav</h4>
        <p class="ds-source">src/components/PaginationNav.astro</p>
        <PaginationNav
          prev={{ url: '#', label: '← Previous', title: 'Previous article' }}
          next={{ url: '#', label: 'Next →', title: 'Next article' }}
        />
      </div>
    </div>

    <h3>Content</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4>Card</h4>
        <p class="ds-source">src/components/Card.astro</p>
        <Card
          title="Designing with tokens"
          href="/blog"
          author={AUTHOR_NAME}
          pubDate={sampleDate}
          tags={sampleTags}
          readingTime={350}
        >
          <p>
            How CSS custom properties shape typography, spacing, color, and
            layout across the site.
          </p>
        </Card>
      </div>
      <div class="ds-component-demo">
        <h4>Tag / Chip</h4>
        <p class="ds-source">src/styles/components.css</p>
        <div class="demo-row">
          <a href="/tags/astro/" class="tag">Astro</a>
          <span class="chip">static chip</span>
        </div>
      </div>
      <div class="ds-component-demo">
        <h4>TagFilterBar</h4>
        <p class="ds-source">src/components/TagFilterBar.astro</p>
        <TagFilterBar tags={sampleTags} {tagData} />
      </div>
      <div class="ds-component-demo">
        <h4>Callout</h4>
        <p class="ds-source">src/styles/components.css</p>
        <div class="callout">
          <strong>Callout title</strong> — highlighted information or notes.
        </div>
      </div>
    </div>

    <h3>Interaction</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4>Button</h4>
        <p class="ds-source">src/styles/components.css</p>
        <div class="demo-row">
          <button type="button" class="button">Primary</button>
          <button type="button" class="button button--outline">Outline</button>
        </div>
      </div>
      <div class="ds-component-demo">
        <h4>ThemeToggle</h4>
        <p class="ds-source">src/components/ThemeToggle.astro</p>
        <div class="demo-row">
          <ThemeToggle />
        </div>
      </div>
      <div class="ds-component-demo">
        <h4>SocialLinks</h4>
        <p class="ds-source">src/components/SocialLinks.astro</p>
        <div class="demo-row">
          <SocialLinks />
        </div>
      </div>
    </div>

    <h3>Integrations</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4>ShareStrip</h4>
        <p class="ds-source">src/components/ShareStrip.astro</p>
        <ShareStrip title={title} {pageUrl} />
      </div>
      <div class="ds-component-demo">
        <h4>Search UI</h4>
        <p class="ds-source">src/pages/search.astro, src/styles/pagefind.css</p>
        <p>
          Pagefind injects its markup at runtime; the site restyles it with
          project tokens. The internals are not rebuilt here.
        </p>
      </div>
      <div class="ds-component-demo ds-component-demo--wide">
        <h4>Contact form fields</h4>
        <p class="ds-source">src/pages/contact.astro</p>
        <form class="contact-form ds-form">
          <div class="ds-form-row">
            <label>
              <span>Name</span>
              <input type="text" placeholder="Your name" />
            </label>
            <label>
              <span>Email</span>
              <input type="email" placeholder="you@example.com" />
            </label>
          </div>
          <label>
            <span>Message</span>
            <textarea rows="4" placeholder="Your message"></textarea>
          </label>
          <button type="button" class="button">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <section class="ds-section">
    <h2>Content Patterns</h2>

    <h3>Article intro</h3>
    <p class="home-hero-lede">
      A large lede paragraph uses <code>var(--type-size-large)</code> to set up
      an article or section.
    </p>

    <h3>Metadata row</h3>
    <p class="meta">
      <strong>{AUTHOR_NAME}</strong>
      <time datetime={sampleDate.toISOString()}>
        {sampleDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <span class="reading-time">3 min read</span>
    </p>

    <h3>Tag list</h3>
    <p class="meta meta-tags">
      {sampleTags.map((tag) => <a href={`/tags/${tag}/`} class="tag">{tag}</a>)}
    </p>
  </section>

  <section class="ds-section">
    <h2>Accessibility Notes</h2>
    <ul>
      <li><strong>Skip link</strong> — keyboard users can jump to main content.</li>
      <li><strong>Focus states</strong> — visible dashed outline with offset.</li>
      <li><strong>Touch targets</strong> — minimum 44px for buttons and icon links.</li>
      <li><strong>Color contrast</strong> — palettes are chosen for both dark and light modes.</li>
      <li><strong>Semantic HTML</strong> — native elements before ARIA.</li>
      <li><strong>Reduced motion</strong> — transitions and animations respect user preference.</li>
    </ul>
  </section>

  <section class="ds-section">
    <h2>Known Gaps &amp; Follow-ups</h2>
    <table class="ds-table">
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col">Note</th>
        </tr>
      </thead>
      <tbody>
        {
          knownGaps.map(({ item, note }) => (
            <tr>
              <td>{item}</td>
              <td>{note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="ds-section">
    <h2>Implementation Notes</h2>
    <ul>
      <li>
        This page widens the default content rail to
        <code>--layout-rail-wide</code> while keeping prose paragraphs at the
        readable <code>--layout-rail-prose</code> measure.
      </li>
      <li>
        <code>--header-height</code> is measured and set by JavaScript; the CSS
        fallback is <code>4.5rem</code>.
      </li>
      <li>
        Pagefind search UI is third-party markup restyled by
        <code>src/styles/pagefind.css</code>.
      </li>
      <li>
        Some page-specific styles use local sizing not yet captured by shared
        tokens.
      </li>
      <li>
        This page is intentionally omitted from the main navigation and uses
        <code>noindex, follow</code> metadata.
      </li>
    </ul>
  </section>
</div>
</Layout>

<style>
  :global(#main-content) {
    max-width: var(--layout-rail-wide);
  }

  .ds-hero {
    margin-bottom: var(--space-section);
    padding-bottom: var(--space-component);
    border-bottom: var(--size-border-pixel) solid var(--border-main);
  }

  .ds-hero-subtitle {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--type-size-small);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-label);
  }

  .ds-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline);
  }

  .ds-hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3em 0.8em;
    font-family: var(--font-mono);
    font-size: var(--type-size-small);
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: 999px;
  }

  .ds-section {
    margin-bottom: var(--space-section);
  }

  .ds-section h2 {
    margin-top: 0;
  }

  .ds-section h3 {
    margin-top: var(--space-xl);
  }

  .ds-section h4 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .ds-principles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-component);
  }

  .ds-principle {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-lg);
  }

  .ds-principle strong {
    color: var(--text-primary);
  }

  .ds-principle span {
    font-size: var(--type-size-small);
    color: var(--text-secondary);
  }

  .ds-type-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: var(--space-component) 0;
  }

  .ds-type-sample {
    padding: var(--space-sm) 0;
    border-bottom: var(--size-border-pixel) solid var(--border-muted);
  }

  .ds-type-sample:last-child {
    border-bottom: none;
  }

  .ds-h1 {
    font-family: var(--font-headers);
    font-weight: var(--font-weight-bold);
    font-size: var(--type-size-h1);
    line-height: var(--line-height-h1);
  }

  .ds-h2 {
    font-family: var(--font-headers);
    font-weight: var(--font-weight-bold);
    font-size: var(--type-size-h2);
    line-height: var(--line-height-h2);
  }

  .ds-h3 {
    font-family: var(--font-headers);
    font-weight: var(--font-weight-bold);
    font-size: var(--type-size-h3);
    line-height: var(--line-height-h3);
  }

  .ds-h4 {
    font-family: var(--font-headers);
    font-weight: var(--font-weight-bold);
    font-size: var(--type-size-h4);
    line-height: var(--line-height-h4);
  }

  .ds-h5 {
    font-family: var(--font-headers);
    font-weight: var(--font-weight-bold);
    font-size: var(--type-size-h5);
    line-height: var(--line-height-h5);
  }

  .ds-body {
    font-size: var(--type-size-body);
    line-height: var(--line-height-body);
  }

  .ds-small {
    font-size: var(--type-size-small);
