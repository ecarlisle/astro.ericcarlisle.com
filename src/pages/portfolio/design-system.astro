---
import HeaderLink from '@ericcarlisle/design-system/components/HeaderLink.astro';
import PaginationNav from '@ericcarlisle/design-system/components/PaginationNav.astro';
import ShareStrip from '@ericcarlisle/design-system/components/ShareStrip.astro';
import ThemeToggle from '@ericcarlisle/design-system/components/ThemeToggle.astro';
import Card from '../../components/Card.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import { AUTHOR_NAME } from '../../consts';
import Layout from '../../layouts/BlogPost.astro';

// The KISS Design System is the design system implemented across this site.
// It is indexable so teams searching for these patterns can find this page.
// KISS stands for "Keep It Stunningly Simple" — explained once in the
// Overview section, not repeated in metadata.
const title = 'KISS Design System';
const description =
  'The KISS Design System implemented across ericcarlisle.com — typography, spacing, color, layout, components, and accessibility decisions.';
const pageUrl = 'https://ericcarlisle.com/portfolio/design-system/';

const sampleDate = new Date('2024-06-15');
// Sample tag data uses the site's real lowercase tag routes so every demo
// link resolves to an actual blog archive page.
const sampleTags = ['3d-printing', 'ai'];

const tagData = {
  allTags: ['3d-printing', 'ai', 'ai-agents', 'documentation', 'software-development'],
  tagCounts: {
    '3d-printing': 2,
    ai: 1,
    'ai-agents': 1,
    documentation: 1,
    'software-development': 1,
  },
};

const colorTokens = [
  { token: '--bg-main', dark: '#0b1020', light: '#f8fafc', usage: 'Page background' },
  { token: '--bg-surface', dark: '#111a2e', light: '#ffffff', usage: 'Cards, header, code blocks' },
  {
    token: '--bg-surface-elevated',
    dark: '#18243a',
    light: '#e8eef7',
    usage: 'Elevated surfaces, hover states',
  },
  { token: '--text-primary', dark: '#f8fafc', light: '#0f172a', usage: 'Headings, primary text' },
  {
    token: '--text-secondary',
    dark: '#cbd5e1',
    light: '#334155',
    usage: 'Body text, descriptions',
  },
  { token: '--text-muted', dark: '#94a3b8', light: '#475569', usage: 'Meta, captions, labels' },
  { token: '--brand-primary', dark: '#5ea8ff', light: '#005fcc', usage: 'Links, actions, focus' },
  {
    token: '--brand-accent',
    dark: '#38d9a9',
    light: '#007a5a',
    usage: 'Link hover, success states',
  },
  { token: '--brand-highlight', dark: '#ffb86b', light: '#a14b00', usage: 'Highlights, marks' },
  { token: '--border-main', dark: '#26344d', light: '#cbd5e1', usage: 'Card borders, dividers' },
  {
    token: '--border-muted',
    dark: '#1a2638',
    light: '#e2e8f0',
    usage: 'Header border, subtle separators',
  },
  { token: '--border-control', dark: '#52627a', light: '#64748b', usage: 'Form input borders' },
];

const semanticColors = [
  { token: '--color-link', usage: 'Default links', darkSource: '--brand-primary' },
  { token: '--color-link-hover', usage: 'Hovered links', darkSource: '--brand-accent' },
  { token: '--color-action', usage: 'Buttons, CTAs', darkSource: '--brand-primary' },
  { token: '--color-action-hover', usage: 'Button hover', darkSource: '#3d8ee0' },
  { token: '--color-focus', usage: 'Focus outlines', darkSource: '--color-link' },
  { token: '--color-success', usage: 'Success states', darkSource: '--brand-accent' },
  { token: '--color-card-bg', usage: 'Card backgrounds', darkSource: '--bg-surface' },
  {
    token: '--color-card-bg-elevated',
    usage: 'Elevated card backgrounds',
    darkSource: '--bg-surface-elevated',
  },
  { token: '--color-card-border', usage: 'Card borders', darkSource: '--border-main' },
];

const spacingTokens = [
  { token: '--space-xs', value: 'calc(var(--rhythm) * 0.5)', mobile: '13 px', desktop: '17 px' },
  { token: '--space-sm', value: 'calc(var(--rhythm) * 0.75)', mobile: '20 px', desktop: '25 px' },
  { token: '--space-md', value: 'var(--rhythm)', mobile: '26 px', desktop: '33 px' },
  { token: '--space-lg', value: 'calc(var(--rhythm) * 1.5)', mobile: '40 px', desktop: '50 px' },
  { token: '--space-xl', value: 'calc(var(--rhythm) * 2)', mobile: '53 px', desktop: '66 px' },
  {
    token: '--space-section',
    value: 'calc(var(--rhythm) * 2.5)',
    mobile: '66 px',
    desktop: '83 px',
  },
  { token: '--space-layout', value: 'calc(var(--rhythm) * 3)', mobile: '79 px', desktop: '99 px' },
];

const typeTokens = [
  { token: '--type-size-h1', mobile: '32 px', desktop: '64 px', lineHeight: '--line-height-h1' },
  { token: '--type-size-h2', mobile: '26 px', desktop: '45 px', lineHeight: '--line-height-h2' },
  { token: '--type-size-h3', mobile: '22 px', desktop: '32 px', lineHeight: '--line-height-h3' },
  { token: '--type-size-h4', mobile: '18 px', desktop: '24 px', lineHeight: '--line-height-h4' },
  { token: '--type-size-h5', mobile: '16 px', desktop: '19 px', lineHeight: '--line-height-h5' },
  {
    token: '--type-size-large',
    mobile: '18 px',
    desktop: '22 px',
    lineHeight: '--line-height-body',
  },
  {
    token: '--type-size-body',
    mobile: '16 px',
    desktop: '18 px',
    lineHeight: '--line-height-body',
  },
  {
    token: '--type-size-small',
    mobile: '13 px',
    desktop: '15 px',
    lineHeight: '--line-height-body',
  },
];

const knownGaps = [
  {
    item: 'Header height',
    note: 'Measured at runtime by JavaScript; the CSS fallback is 4.5rem.',
  },
  {
    item: 'Pagefind search UI',
    note: 'Third-party markup restyled by src/styles/pagefind.css.',
  },
  {
    item: 'Portfolio case-study grid',
    note: 'Page-local 1.6fr / 0.8fr sizing in src/pages/portfolio.astro.',
  },
  {
    item: 'Homepage role text',
    note: 'One-off letter-spacing on the homepage hero role; not tokenized.',
  },
  {
    item: 'Page-specific animations',
    note: 'Scroll-driven header behavior and card entrance motion are scoped to specific pages.',
  },
];
---

<Layout
  title={title}
  {description}
  pageType="portfolio"
  robots="index, follow"
  breadcrumbs={[
    { name: 'Home', item: 'https://ericcarlisle.com/' },
    { name: 'Portfolio', item: 'https://ericcarlisle.com/portfolio/' },
    { name: 'KISS Design System', item: pageUrl },
  ]}
>
<div data-pagefind-ignore>
  <div class="ds-hero">
    <p class="ds-hero-subtitle">The design system implemented across ericcarlisle.com</p>
    <div class="ds-hero-meta">
      <span class="ds-hero-badge">Astro + vanilla CSS</span>
      <span class="ds-hero-badge">@ericcarlisle/design-system</span>
      <span class="ds-hero-badge">Living reference</span>
      <span class="ds-hero-badge">
        Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </span>
    </div>
  </div>

  <section class="ds-section">
    <h2>Overview</h2>
    <p>
      This page documents the design system implemented across the site. The
      CSS custom properties, components, and layout patterns shown here are the
      source of truth; the page renders and explains what is already in
      production.
    </p>
    <p>
      KISS stands for Keep It Stunningly Simple, which is the working rule
      behind the decisions documented here.
    </p>
    <p>
      The tokens, fonts, and the components with no site-specific content or
      business logic — <code>PageHeader</code>, <code>HeaderLink</code>, <code>ThemeToggle</code>, <code>PaginationNav</code>, <code>ShareStrip</code>, <code>FormattedDate</code>, <code>CategoryTag</code>, <code>CategoryIcon</code> — live in the <code>@ericcarlisle/design-system</code> workspace package under <code>packages/design-system/</code>, so they can be reused by other projects without dragging this site's blog content model along. Every other component shown below stays in <code>src/components/</code> because it's coupled to this site's content — blog tag taxonomy, analytics, or copy that's specific to ericcarlisle.com.
    </p>
    <p>
      It is intended as a personal reference and may later be shared with
      interviewers or hiring managers as a portfolio artifact.
    </p>
    <p>
      <a href="/design-system/lab/" class="button">
        Open the component lab
      </a>
    </p>
    <p>
      The component lab provides an interactive environment for developing and
      testing components in isolation, with live previews and accessibility
      testing.
    </p>
  </section>

  <section class="ds-section">
    <h2>Design Principles</h2>
    <div class="ds-principles">
      <div class="ds-principle">
        <strong>Performance first</strong>
        <span>Static output, minimal JavaScript, no global bundles for page-specific features.</span>
      </div>
      <div class="ds-principle">
        <strong>Minimal JavaScript</strong>
        <span>Prefer Astro, HTML, and CSS before adding client-side behavior.</span>
      </div>
      <div class="ds-principle">
        <strong>Semantic HTML</strong>
        <span>Native elements before ARIA; correct heading order; one h1 per page.</span>
      </div>
      <div class="ds-principle">
        <strong>Accessibility</strong>
        <span>Keyboard, visible focus, contrast, reduced motion, and touch targets.</span>
      </div>
      <div class="ds-principle">
        <strong>Fluid responsive design</strong>
        <span>clamp() tokens for type and spacing; mobile-first breakpoints.</span>
      </div>
      <div class="ds-principle">
        <strong>Content-first layout</strong>
        <span>Readable measure, generous whitespace, clear visual hierarchy.</span>
      </div>
    </div>
  </section>

  <section class="ds-section">
    <h2>Typography</h2>
    <p>
      Headings use <code>var(--font-headers)</code>; body copy uses
      <code>var(--font-copy)</code>; monospace elements use
      <code>var(--font-mono)</code>.
    </p>

    <h3>Visual scale</h3>
    <div class="ds-type-stack">
      <div class="ds-type-sample ds-h1">Heading 1</div>
      <div class="ds-type-sample ds-h2">Heading 2</div>
      <div class="ds-type-sample ds-h3">Heading 3</div>
      <div class="ds-type-sample ds-h4">Heading 4</div>
      <div class="ds-type-sample ds-h5">Heading 5</div>
      <div class="ds-type-sample ds-body">
        Body text with a <a href="#">sample link</a> and <code>inline code</code>.
      </div>
      <div class="ds-type-sample ds-small">Small text for meta, captions, and labels.</div>
    </div>

    <h3>Token usage</h3>
    <table class="ds-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Mobile</th>
          <th scope="col">Desktop</th>
          <th scope="col">Line height</th>
        </tr>
      </thead>
      <tbody>
        {
          typeTokens.map(({ token, mobile, desktop, lineHeight }) => (
            <tr>
              <td><code>{token}</code></td>
              <td>{mobile}</td>
              <td>{desktop}</td>
              <td><code>{lineHeight}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 id="content-samples">Content samples</h3>
    <blockquote>
      Blockquotes use a left border and slightly larger text. This is how a pull
      quote or emphasized statement appears.
    </blockquote>

    <pre><code>/* Example token usage */
.card {'{'}
  padding: var(--space-component);
  background: var(--color-card-bg);
  border-radius: var(--radius-lg);
{'}'}</code></pre>
  </section>

  <section class="ds-section">
    <h2>Heading Permalinks</h2>
    <p>
      Content-section titles that deserve a stable, shareable URL get a visible
      chain-link permalink as a sibling <em>after</em> the heading. The pattern is
      native fragment navigation — an <code>aria-hidden</code> link-chain SVG inside
      an <code>a.permalink</code> whose <code>href</code> matches the heading's
      explicit, lowercase kebab-case <code>id</code>, with
      <code>aria-label="Link to &lt;Visible Title&gt;"</code>. No clipboard and no
      runtime JavaScript.
    </p>
    <ul class="ds-permalink-rules">
      <li>
        <strong>Inclusion</strong> — add to content-section headings that deserve a
        stable deep link (e.g. portfolio case-study titles and the “How I work”
        section). Do not add to article-prose headings or to headings already
        covered by the article table of contents.
      </li>
      <li>
        <strong>Stable-ID contract</strong> — each heading carries a unique,
        explicit, lowercase kebab-case <code>id</code>, never slugified from the
        visible title at runtime. Treat the IDs as permanent public URLs.
      </li>
      <li>
        <strong>Structure</strong> — the permalink is a sibling anchor (never nested
        inside the heading or another link).
      </li>
      <li>
        <strong>Accessibility</strong> — 44px touch target, visible dashed
        <code>:focus-visible</code> outline, and
        <code>scroll-margin-top: calc(var(--header-height, 4.5rem) + var(--space-component))</code>
        so a fragment lands clear of the fixed header. A restrained
        <code>:target</code> highlight marks the landing; under
        <code>prefers-reduced-motion</code> it becomes a static inset accent bar and
        permalink transitions are disabled.
      </li>
      <li>
        <strong>Responsive wrapping</strong> — the heading and its permalink share one
        inline text flow, bound by a trailing non-breaking space, so the icon always
        sits beside the title's final word and never orphaned onto its own row.
      </li>
      <li>
        <strong>Tokens</strong> — uses only existing tokens; no new tokens are
        introduced.
      </li>
    </ul>
    <p class="ds-source">
      Canonical implementation: <code>src/pages/portfolio.astro</code>. Live use:
      <a href="/portfolio/#kiss-design-system">/portfolio/#kiss-design-system</a>.
    </p>

    <h3>Dark theme</h3>
    <div class="ds-permalink-demo" data-theme="dark">
      <div class="portfolio-title">
        <h2 id="ds-permalink-h2">Designing section landmarks</h2>
        <a class="permalink" href="#ds-permalink-h2" aria-label="Link to Designing section landmarks">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <div class="portfolio-title">
        <h3 id="ds-permalink-h3">Reengineering enterprise commerce performance</h3>
        <a class="permalink" href="#ds-permalink-h3" aria-label="Link to Reengineering enterprise commerce performance">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <div class="portfolio-title portfolio-title--wrapped">
        <h3 id="ds-permalink-h3-wrapped">Building integration layers for product teams across many releases</h3>
        <a class="permalink" href="#ds-permalink-h3-wrapped" aria-label="Link to Building integration layers for product teams across many releases">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <p class="ds-permalink-caption">
        Default / hover / keyboard-focus (Tab to the link) / targeted (choose the
        permalink): the narrow example shows the icon wrapping with the final title
        word instead of orphaning.
      </p>
    </div>

    <h3>Light theme</h3>
    <div class="ds-permalink-demo" data-theme="light" style="background: var(--bg-main); color: var(--text-primary);">
      <div class="portfolio-title">
        <h2 id="ds-permalink-h2-light">Designing section landmarks</h2>
        <a class="permalink" href="#ds-permalink-h2-light" aria-label="Link to Designing section landmarks">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <div class="portfolio-title">
        <h3 id="ds-permalink-h3-light">Reengineering enterprise commerce performance</h3>
        <a class="permalink" href="#ds-permalink-h3-light" aria-label="Link to Reengineering enterprise commerce performance">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <div class="portfolio-title portfolio-title--wrapped">
        <h3 id="ds-permalink-h3-wrapped-light">Building integration layers for product teams across many releases</h3>
        <a class="permalink" href="#ds-permalink-h3-wrapped-light" aria-label="Link to Building integration layers for product teams across many releases">
          <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </a>
      </div>
      <p class="ds-permalink-caption">
        Same pattern rendered in the light theme via a <code>data-theme="light"</code>
        container; the semantic tokens (<code>--color-link</code>, focus, surface)
        re-map automatically.
      </p>
    </div>
  </section>

  <section class="ds-section">
    <h2>Color Tokens</h2>
    <p>
      The default theme is dark. A light theme is applied via
      <code>[data-theme="light"]</code> or system preference.
    </p>

    <h3>Core palette</h3>
    <div class="ds-color-grid">
      {
        colorTokens.map(({ token, dark, light, usage }) => (
          <div class="ds-color-card">
            <div class="ds-color-swatch" style={`background: var(${token});`} />
            <div class="ds-color-info">
              <code>{token}</code>
              <span class="ds-color-usage">{usage}</span>
              <span class="ds-color-modes">Dark: {dark} / Light: {light}</span>
            </div>
          </div>
        ))
      }
    </div>

    <h3>Semantic roles</h3>
    <table class="ds-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Usage</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          semanticColors.map(({ token, usage, darkSource }) => (
            <tr>
              <td><code>{token}</code></td>
              <td>{usage}</td>
              <td><code>{darkSource}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="ds-section">
    <h2>Spacing Scale</h2>
    <p>
      Spacing is derived from the fluid rhythm token <code>var(--rhythm)</code>
      (≈ 26 px on mobile, ≈ 33 px on desktop).
    </p>
    <div class="ds-spacing-table">
      {
        spacingTokens.map(({ token, value, mobile, desktop }) => (
          <div class="ds-spacing-row">
            <div class="ds-spacing-label">
              <code>{token}</code>
              <span>{value}</span>
              <span class="ds-spacing-px">{mobile} → {desktop}</span>
            </div>
            <div class="ds-spacing-bar" style={`width: var(${token});`} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="ds-section">
    <h2>Layout Rails</h2>
    <p>
      Reading width and page width are intentionally separate. Prose stays narrow
      for readability, while pages and wide components can use more viewport
      space.
    </p>
    <div class="ds-rail-diagram">
      <div class="ds-rail-bar ds-rail-prose">
        <span>.rail--prose</span>
        <span>68ch — readable measure</span>
      </div>
      <div class="ds-rail-bar ds-rail-page">
        <span>.rail--page</span>
        <span>72rem — default page max</span>
      </div>
      <div class="ds-rail-bar ds-rail-wide">
        <span>.rail--wide</span>
        <span>80rem — wide layouts</span>
      </div>
    </div>
  </section>

  <section class="ds-section">
    <h2>Components</h2>

    <h3>Navigation</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4 id="headerlink">HeaderLink</h4>
        <p class="ds-source">packages/design-system/src/components/HeaderLink.astro</p>
        <div class="demo-row">
          <HeaderLink href="/portfolio/design-system">Active</HeaderLink>
          <HeaderLink href="/blog">Inactive</HeaderLink>
        </div>
      </div>
      <div class="ds-component-demo">
        <h4 id="back-link">Back link</h4>
        <p class="ds-source">src/styles/components.css</p>
        <a href="/portfolio" class="back-link">← Back to portfolio</a>
      </div>
      <div class="ds-component-demo">
        <h4 id="paginationnav">PaginationNav</h4>
        <p class="ds-source">packages/design-system/src/components/PaginationNav.astro</p>
        <PaginationNav
          prev={{ url: '#', label: '← Previous', title: 'Previous article' }}
          next={{ url: '#', label: 'Next →', title: 'Next article' }}
        />
      </div>
    </div>

    <h3>Content</h3>
    <div class="ds-component-group">
      <div class="ds-component-demo">
        <h4 id="card">Card</h4>
        <p class="ds-source">src/components/Card.astro</p>
        <Card
          title="Designing with tokens"
          href="/blog"
          author={AUTHOR_NAME}
          pubDate={sampleDate}
          tags={sampleTags}
          readingTime={350}
        >
          <p>
            How CSS custom properties shape typography, spacing, color, and
            layout across the site.
          </p>
        </Card>
      </div>
      <div class="ds-component-demo">
        <h3 id="tag-chip">Tag / Chip</h3>
        <p class="ds-source">src/styles/components.css</p>
        <div class="demo-row">
