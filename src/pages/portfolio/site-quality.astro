---
import siteQuality from '../../generated/site-quality.json';
import Layout from '../../layouts/BlogPost.astro';

const {
  generatedAt,
  commit,
  environment,
  routes,
  bundles,
  stories,
  accessibility,
  validation,
  isolation,
  limitations,
} = siteQuality;

const prod = bundles.productionSite;
const lab = bundles.componentLab;

const measurementDate = new Date(generatedAt);
const dateStr = measurementDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const timeStr = measurementDate.toLocaleTimeString('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  timeZoneName: 'short',
});

function formatBytes(bytes: number) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB'];
  const i = bytes < k ? 0 : bytes < k * k ? 1 : 2;
  const val = i === 0 ? bytes : bytes / (i === 1 ? k : k * k);
  return `${val.toFixed(i === 0 ? 0 : 1)} ${sizes[i]}`;
}

function formatCls(val: number | null | undefined) {
  if (!val && val !== 0) return '—';
  return val.toFixed(3);
}

function formatMs(val: number | null | undefined) {
  if (!val) return '—';
  return `${(val / 1000).toFixed(1)} s`;
}
const lh = siteQuality.lighthouse as {
  performance: number;
  accessibility: number;
  'best-practices': number;
  seo: number;
  lcp: number | null;
  cls: number | null;
  tbt: number | null;
  url: string;
} | null;
---

<Layout
  title="Site Quality"
  description="Measurable quality characteristics of ericcarlisle.com: performance, accessibility, bundle size, test coverage, and Storybook component-lab evidence."
  pageType="portfolio"
  robots="index, follow"
  breadcrumbs={[
    { name: 'Home', item: 'https://ericcarlisle.com/' },
    { name: 'Portfolio', item: 'https://ericcarlisle.com/portfolio/' },
    { name: 'Site Quality', item: 'https://ericcarlisle.com/portfolio/site-quality/' },
  ]}
>
  <header class="page-intro">
    <p class="lede">
      This page reports reproducible measurements for the live site and its
      component development system. Every number comes from a current
      reproducible source — build output, generated metadata, or test results.
    </p>
    <dl class="measurement-meta">
      <div><dt>Measurement date</dt><dd>{dateStr} at {timeStr}</dd></div>
      <div><dt>Source commit</dt><dd><code>{commit}</code></dd></div>
      <div><dt>Environment</dt><dd>Node {environment.node} on {environment.platform}, Astro static build</dd></div>
    </dl>
  </header>

  <hr />

  <section id="overview">
    <h2>Quality overview</h2>

    <div class="metric-grid">
      <div class="metric-card">
        <h3>Routes</h3>
        <span class="metric-value">{routes.totalGenerated}</span>
        <span class="metric-label">generated HTML pages</span>
      </div>

      <div class="metric-card">
        <h3>Storybook stories</h3>
        <span class="metric-value">{stories.total}</span>
        <span class="metric-label">{stories.componentStories} component + {stories.foundationStories} foundation</span>
      </div>

      <div class="metric-card">
        <h3>A11y tests</h3>
        <span class="metric-value">{accessibility.storybookA11yTests + accessibility.routeA11yTests}</span>
        <span class="metric-label">{accessibility.storybookA11yTests} Storybook + {accessibility.routeA11yTests} route — all passing</span>
      </div>

      <div class="metric-card">
        <h3>Production JS</h3>
        <span class="metric-value">{formatBytes(prod.totalJavaScriptBytes)}</span>
        <span class="metric-label">total; {formatBytes(prod.totalJavaScriptGzipBytes)} gzipped</span>
      </div>

      <div class="metric-card">
        <h3>Per-route JS</h3>
        <span class="metric-value">{formatBytes(Object.values(prod.routeJavaScript).find(r => r.assets.length > 0)?.totalBytes || 0)}</span>
        <span class="metric-label">loaded by each normal page</span>
      </div>

      <div class="metric-card">
        <h3>Production CSS</h3>
        <span class="metric-value">{formatBytes(prod.totalCssBytes)}</span>
        <span class="metric-label">total stylesheets</span>
      </div>

      <div class="metric-card">
        <h3>Route a11y tests</h3>
        <span class="metric-value">{accessibility.routeA11yTests}</span>
        <span class="metric-label">all passing</span>
      </div>

      <div class="metric-card">
        <h3>Storybook isolated</h3>
        <span class="metric-value">{isolation.isolated ? 'Yes' : 'No'}</span>
        <span class="metric-label">no Storybook assets on normal pages</span>
      </div>
    </div>
  </section>

  <hr />

  <section id="performance">
    <h2>Performance</h2>

    {lh ? (
      <>
        <p>
          Lighthouse measurements taken locally against the built static output
          served by a plain HTTP server. Device: desktop. Throttling: provided
          by Lighthouse default. These are lab measurements, not production
          Core Web Vitals.
        </p>

        <div class="metric-grid">
          <div class="metric-card">
            <h3>Performance</h3>
            <span class="metric-value">{lh.performance}</span>
            <span class="metric-label">/ 100</span>
          </div>
          <div class="metric-card">
            <h3>Accessibility</h3>
            <span class="metric-value">{lh.accessibility}</span>
            <span class="metric-label">/ 100</span>
          </div>
          <div class="metric-card">
            <h3>Best Practices</h3>
            <span class="metric-value">{lh['best-practices']}</span>
            <span class="metric-label">/ 100</span>
          </div>
          <div class="metric-card">
            <h3>SEO</h3>
            <span class="metric-value">{lh.seo}</span>
            <span class="metric-label">/ 100</span>
          </div>
          <div class="metric-card">
            <h3>LCP</h3>
            <span class="metric-value">{formatMs(lh.lcp)}</span>
            <span class="metric-label">Largest Contentful Paint</span>
          </div>
          <div class="metric-card">
            <h3>CLS</h3>
            <span class="metric-value">{formatCls(lh.cls)}</span>
            <span class="metric-label">Cumulative Layout Shift</span>
          </div>
          <div class="metric-card">
            <h3>TBT</h3>
            <span class="metric-value">{formatMs(lh.tbt)}</span>
            <span class="metric-label">Total Blocking Time</span>
          </div>
        </div>
      </>
    ) : (
      <p>
        No Lighthouse report is currently available. Run
        {' '}<code>pnpm lighthouse:all</code> to generate one, then
        {' '}<code>pnpm quality:generate</code> to include it here.
      </p>
    )}

    <p class="note">
      The CI pipeline enforces a Lighthouse performance budget:
      performance ≥ 95, accessibility ≥ 95, SEO ≥ 100,
      best-practices ≥ 95. See <code>lighthouserc.js</code>.
    </p>
  </section>

  <hr />

  <section id="bundle-measurement">
    <h2>Production bundle</h2>

    <p class="methodology-note">
      Bundle figures are generated from the Astro-only production build.
      Storybook assets under <code>/design-system/lab/</code> are measured
      separately and excluded from ordinary site-route totals.
    </p>

    <h3>Production site</h3>
    <table class="measurement-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Total JavaScript</td>
          <td>{formatBytes(prod.totalJavaScriptBytes)}</td>
        </tr>
        <tr>
          <td>Total JavaScript (gzip)</td>
          <td>{formatBytes(prod.totalJavaScriptGzipBytes)}</td>
        </tr>
        <tr>
          <td>Total CSS</td>
          <td>{formatBytes(prod.totalCssBytes)}</td>
        </tr>
        <tr>
          <td>Largest JavaScript asset</td>
          <td><code>{prod.largestJavaScriptAsset?.name}</code> ({formatBytes(prod.largestJavaScriptAsset?.bytes || 0)})</td>
        </tr>
        <tr>
          <td>Astro page scripts</td>
          <td>{formatBytes(prod.astroScriptsBytes)}</td>
        </tr>
        <tr>
          <td>Search (Pagefind)</td>
          <td>{formatBytes(prod.pagefindScriptsBytes)}</td>
        </tr>
        <tr>
          <td>Analytics (Partytown)</td>
          <td>{formatBytes(prod.partytownScriptsBytes)}</td>
        </tr>
      </tbody>
    </table>

    <h3>Route-level JavaScript</h3>
    <p>
      Every normal Astro page loads a single shared JavaScript bundle.
      The table below shows which assets each route references and their
      total size.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Route</th>
          <th>JS assets</th>
          <th>Total bytes</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(prod.routeJavaScript).map(([route, info]) => (
          <tr>
            <td><code>{route}</code></td>
            <td>{info.assets.length > 0 ? info.assets.join(', ') : 'none'}</td>
            <td>{formatBytes(info.totalBytes)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3>Component lab (Storybook)</h3>
    <p>
      The Storybook application at <code>/design-system/lab/</code> is a
      separate application. Its JavaScript is not loaded by ordinary blog
      pages. The isolation verification below confirms this.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Total JavaScript</td>
          <td>{formatBytes(lab.totalJavaScriptBytes)}</td>
        </tr>
        <tr>
          <td>Total JavaScript (gzip)</td>
          <td>{formatBytes(lab.totalJavaScriptGzipBytes)}</td>
        </tr>
        <tr>
          <td>Files</td>
          <td>{lab.fileCount}</td>
        </tr>
      </tbody>
    </table>

    <details>
      <summary>Largest Storybook chunks</summary>
      <table class="measurement-table">
        <thead>
          <tr>
            <th>Chunk</th>
            <th>Size</th>
            <th>Category</th>
          </tr>
        </thead>
        <tbody>
          {lab.largestChunks.slice(0, 5).map((chunk) => (
            <tr>
              <td><code>{chunk.name}</code></td>
              <td>{formatBytes(chunk.bytes)}</td>
              <td>{chunk.label}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </section>

  <hr />

  <section id="isolation">
    <h2>Storybook isolation</h2>

    <p>
      Storybook is built as a separate static application and copied into
      <code>dist/design-system/lab/</code> during deployment. It is not
      part of the Astro build graph and is not imported by any production
      component.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Check</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Storybook assets isolated to <code>/design-system/lab/</code></td>
          <td>{isolation.isolated ? '✅' : '❌'}</td>
        </tr>
        <tr>
          <td>Static scan: Storybook references in production JS/CSS</td>
          <td>{isolation.contaminatedFiles} found{isolation.contaminatedFiles === 0 ? ' (clean)' : ''}</td>
        </tr>
        <tr>
          <td>Network test: ordinary pages loading Storybook assets</td>
          <td>0 (verified via Playwright)</td>
        </tr>
      </tbody>
    </table>

    <p class="methodology-note">
      {isolation.checkType} and confirmed by Playwright network-interception
      tests in <code>tests/storybook-isolation.spec.ts</code>.
    </p>

    <p class="note">
      The Storybook bundle is approximately {formatBytes(lab.totalJavaScriptBytes)}
      (uncompressed). This is the weight of a design-system development tool,
      not the blog. It is served only to users who explicitly visit
      <code>/design-system/lab/</code>.
    </p>
  </section>

  <hr />

  <section id="accessibility">
    <h2>Accessibility verification</h2>

    <p>
      Automated accessibility checks run against every Storybook component
      story and every primary site route. The tests use axe-core through
      Playwright.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Scope</th>
          <th>Tests</th>
          <th>Passing</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Storybook component stories</td>
          <td>{accessibility.storybookA11yTests}</td>
          <td>{accessibility.storybookA11yPassed} / {accessibility.storybookA11yTests}</td>
        </tr>
        <tr>
          <td>Site routes</td>
          <td>{accessibility.routeA11yTests}</td>
          <td>{accessibility.routeA11yPassed} / {accessibility.routeA11yTests}</td>
        </tr>
      </tbody>
    </table>

    <div class="callout">
      <h3>What remains manual</h3>
      <p>{accessibility.coverageNote}</p>
    </div>
  </section>

  <hr />

  <section id="storybook">
    <h2>Component system (Storybook)</h2>

    <p>
      The component lab at <a href="/design-system/lab/">/design-system/lab/</a>
      documents every reusable Astro component in the design system. Stories
      cover default states, edge cases (long labels, narrow viewports), and
      fixture-backed composite layouts.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Total stories</td>
          <td>{stories.total}</td>
        </tr>
        <tr>
          <td>Component stories</td>
          <td>{stories.componentStories}</td>
        </tr>
        <tr>
          <td>Foundation stories</td>
          <td>{stories.foundationStories}</td>
        </tr>
        <tr>
          <td>Storybook accessibility tests</td>
          <td>{accessibility.storybookA11yTests}</td>
        </tr>
      </tbody>
    </table>

    <p>
      See <a href="/portfolio/design-system/">Design System Companion</a> for
      component documentation, design tokens, and usage guidelines.
    </p>
  </section>

  <hr />

  <section id="build-and-validation">
    <h2>Build and validation</h2>

    <p>
      The following commands protect the site. Most run in CI on every push
      to <code>main</code>.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Command</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        {validation.commands.map((cmd) => (
          <tr>
            <td><code>{cmd.command}</code></td>
            <td>{cmd.purpose}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="methodology-note">
      {validation.ci}
    </p>
  </section>

  <hr />

  <section id="measurement-limitations">
    <h2>Measurement limitations</h2>
    <ul class="limitation-list">
      {limitations.map((limitation) => (
        <li>{limitation}</li>
      ))}
    </ul>
  </section>

  <hr />

  <section id="methodology">
    <h2>Methodology</h2>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Measurement</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Bundle measurements</td>
          <td>{siteQuality.provenance.bundleMeasurements}</td>
        </tr>
        <tr>
          <td>Story counts</td>
          <td>{siteQuality.provenance.storyCounts}</td>
        </tr>
        <tr>
          <td>Lighthouse</td>
          <td>{siteQuality.provenance.lighthouse}</td>
        </tr>
        <tr>
          <td>Accessibility tests</td>
          <td>{siteQuality.provenance.accessibilityTests}</td>
        </tr>
        <tr>
          <td>Storybook isolation</td>
          <td>{siteQuality.provenance.storybookIsolation}</td>
        </tr>
      </tbody>
    </table>
  </section>
</Layout>

<style>
  .page-intro .lede {
    font-size: var(--type-size-large);
    line-height: 1.55;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    max-width: var(--layout-rail-prose);
  }

  .measurement-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-component) var(--space-component-lg);
    margin-block: var(--space-component);
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-md);
    font-size: var(--type-size-small);
  }

  .measurement-meta div {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .measurement-meta dt {
    color: var(--text-muted);
    font-size: var(--type-size-small);
  }

  .measurement-meta dd {
    margin: 0;
  }

  .measurement-meta code {
    font-size: var(--type-size-small);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-component);
    margin-block: var(--space-component);
  }

  .metric-card {
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .metric-card h3 {
    margin: 0;
    font-size: var(--type-size-small);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-label);
    color: var(--text-muted);
  }

  .metric-value {
    font-size: var(--type-size-h3);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-mono);
    color: var(--text-primary);
    line-height: 1.1;
  }

  .metric-label {
    font-size: var(--type-size-small);
    color: var(--text-secondary);
  }

  .measurement-table {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-component);
    font-size: var(--type-size-small);
  }

  .measurement-table th,
  .measurement-table td {
    text-align: left;
    padding: var(--space-sm) var(--space-inline);
    border-bottom: var(--size-border-pixel) solid var(--border-main);
    vertical-align: top;
  }

  .measurement-table th {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .measurement-table code {
    font-size: var(--type-size-small);
    word-break: break-all;
  }

  .note,
  .callout {
    padding: var(--space-component);
    background: var(--bg-surface);
    border-inline-start: 3px solid var(--brand-accent);
    border-radius: var(--radius-md);
    margin-block: var(--space-component);
    font-size: var(--type-size-small);
  }

  .callout h3 {
    margin-top: 0;
    font-size: var(--type-size-base);
  }

  .methodology-note {
    font-size: var(--type-size-small);
    color: var(--text-secondary);
    font-style: italic;
  }

  .limitation-list {
    list-style: disc;
    padding-inline-start: 1.25em;
  }

  .limitation-list li {
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
  }

  details {
    margin-block: var(--space-component);
  }

  details summary {
    cursor: pointer;
    font-weight: var(--font-weight-bold);
    color: var(--color-link);
  }

  details summary:hover {
    color: var(--color-link-hover);
  }

  hr {
    margin-block: var(--space-section);
    border: none;
    border-top: var(--size-border-pixel) solid var(--border-main);
  }

  @media (max-width: 720px) {
    .metric-grid {
      grid-template-columns: 1fr;
    }

    .measurement-table th,
    .measurement-table td {
      padding: var(--space-xs) var(--space-inline);
    }
  }
</style>
