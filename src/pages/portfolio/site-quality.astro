---
import siteQuality from '../../generated/site-quality.json';
import Layout from '../../layouts/BlogPost.astro';
import { lighthousePath } from '../../lib/site-quality';

const {
  generatedAt,
  commit,
  environment,
  routes,
  staticDeployment,
  routeMeasurements,
  componentLab,
  stories,
  accessibility,
  validation,
  isolation,
  featureLoading,
  limitations,
} = siteQuality;

const measurementDate = new Date(generatedAt);
const dateStr = measurementDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const timeStr = measurementDate.toLocaleTimeString('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  timeZoneName: 'short',
});

function formatBytes(bytes: number) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB'];
  const i = bytes < k ? 0 : bytes < k * k ? 1 : 2;
  const val = i === 0 ? bytes : bytes / (i === 1 ? k : k * k);
  return `${val.toFixed(i === 0 ? 0 : 1)} ${sizes[i]}`;
}

function formatCls(val: number | null | undefined) {
  if (!val && val !== 0) return '—';
  return val.toFixed(3);
}

function formatMs(val: number | null | undefined) {
  if (!val) return '—';
  return `${(val / 1000).toFixed(1)} s`;
}
---

<Layout
  title="Site Quality"
  description="Measurable quality characteristics of ericcarlisle.com: performance, accessibility, bundle size, test coverage, and Storybook component-lab evidence."
  pageType="portfolio"
  robots="index, follow"
  breadcrumbs={[
    { name: 'Home', item: 'https://ericcarlisle.com/' },
    { name: 'Portfolio', item: 'https://ericcarlisle.com/portfolio/' },
    { name: 'Site Quality', item: 'https://ericcarlisle.com/portfolio/site-quality/' },
  ]}
>
  <header class="page-intro">
    <p class="lede">
      This page reports reproducible measurements for the deployable
      production build and its component development system. Every number
      comes from generated build output, test results, or metadata — not
      fabricated values or historical reports. Performance figures are lab
      measurements of the built static output; they are not production Core
      Web Vitals or live-network measurements.
    </p>
    <dl class="measurement-meta">
      <div><dt>Measurement date</dt><dd>{dateStr} at {timeStr}</dd></div>
      <div><dt>Source commit</dt><dd><code>{commit}</code></dd></div>
      <div><dt>Environment</dt><dd>Node {environment.node}, {environment.build}</dd></div>
      <div><dt>Type</dt><dd>{environment.measurementType}</dd></div>
    </dl>
  </header>

  <hr />

  <section id="overview">
    <h2>Quality overview</h2>

    <div class="metric-grid">
      <div class="metric-card">
        <h3>Routes</h3>
        <span class="metric-value">{routes.totalGenerated}</span>
        <span class="metric-label">generated HTML pages</span>
      </div>

      <div class="metric-card">
        <h3>Storybook stories</h3>
        <span class="metric-value">{stories.total || '—'}</span>
        <span class="metric-label">{stories.componentStories || 0} component + {stories.foundationStories || 0} foundation</span>
      </div>

      {accessibility && (
        <>
          <div class="metric-card">
            <h3>A11y tests</h3>
            <span class="metric-value">{accessibility.totalTests}</span>
            <span class="metric-label">{accessibility.passedTests} passed · {accessibility.failedTests} failed · {accessibility.skippedTests} skipped</span>
          </div>
          <div class="metric-card">
            <h3>Route a11y tests</h3>
            <span class="metric-value">{accessibility.routeTests}</span>
            <span class="metric-label">{accessibility.routePassed} passing</span>
          </div>
          <div class="metric-card">
            <h3>Storybook a11y tests</h3>
            <span class="metric-value">{accessibility.storybookTests}</span>
            <span class="metric-label">{accessibility.storybookPassed} passing</span>
          </div>
        </>
      )}

      <div class="metric-card">
        <h3>Production JS (static)</h3>
        <span class="metric-value">{formatBytes(staticDeployment.totalJavaScript.bytes)}</span>
        <span class="metric-label">{formatBytes(staticDeployment.totalJavaScript.gzipBytes)} gzip · {staticDeployment.totalJavaScript.fileCount} files</span>
      </div>

      <div class="metric-card">
        <h3>Per-route JS (from HTML)</h3>
        <span class="metric-value">{formatBytes(Object.values(routeMeasurements).find((r: any) => r.totalBytes > 0)?.totalBytes || 0)}</span>
        <span class="metric-label">referenced by each normal page (single shared bundle)</span>
      </div>

      <div class="metric-card">
        <h3>Production CSS</h3>
        <span class="metric-value">{formatBytes(staticDeployment.totalCss.bytes)}</span>
        <span class="metric-label">{staticDeployment.totalCss.fileCount} stylesheets</span>
      </div>

      <div class="metric-card">
        <h3>Storybook isolated</h3>
        <span class="metric-value">{isolation.isolated ? 'Yes' : 'No'}</span>
        <span class="metric-label">{isolation.contaminatedFiles} Storybook references in production JS/CSS</span>
      </div>
    </div>
  </section>

  <hr />

  <section id="performance">
    <h2>Performance</h2>

    {siteQuality.lighthouse !== null && (siteQuality.lighthouse as unknown as any[]).length > 0 ? (
      <>
        <p>
          Lighthouse measures the deployable production build (the static
          output in <code>dist/</code>) by serving it through a temporary
          local server during the build pipeline. The route labels below are
          paths on that built site. These are lab measurements of the
          deployment candidate, not production Core Web Vitals and not
          live-network performance.
        </p>

        {(siteQuality.lighthouse as unknown as any[]).map((lh: any) => (
          <div class="lh-route-block">
            <h3><code>{lighthousePath(lh.url)}</code></h3>
            <p class="methodology-note">
              Measured: {lh.fetchedAt ? new Date(lh.fetchedAt).toLocaleString() : 'unknown'}
              · Device: {lh.device} · Throttling: {lh.throttling}
            </p>
            <div class="metric-grid">
              <div class="metric-card">
                <h3>Performance</h3>
                <span class="metric-value">{lh.scores.performance}</span>
                <span class="metric-label">/ 100</span>
              </div>
              <div class="metric-card">
                <h3>Accessibility</h3>
                <span class="metric-value">{lh.scores.accessibility}</span>
                <span class="metric-label">/ 100</span>
              </div>
              <div class="metric-card">
                <h3>Best Practices</h3>
                <span class="metric-value">{lh.scores['best-practices']}</span>
                <span class="metric-label">/ 100</span>
              </div>
              <div class="metric-card">
                <h3>SEO</h3>
                <span class="metric-value">{lh.scores.seo}</span>
                <span class="metric-label">/ 100</span>
              </div>
              <div class="metric-card">
                <h3>LCP</h3>
                <span class="metric-value">{formatMs(lh.metrics.lcp)}</span>
                <span class="metric-label">Largest Contentful Paint</span>
              </div>
              <div class="metric-card">
                <h3>CLS</h3>
                <span class="metric-value">{formatCls(lh.metrics.cls)}</span>
                <span class="metric-label">Cumulative Layout Shift</span>
              </div>
              <div class="metric-card">
                <h3>TBT</h3>
                <span class="metric-value">{formatMs(lh.metrics.tbt)}</span>
                <span class="metric-label">Total Blocking Time</span>
              </div>
              <div class="metric-card">
                <h3>FCP</h3>
                <span class="metric-value">{formatMs(lh.metrics.fcp)}</span>
                <span class="metric-label">First Contentful Paint</span>
              </div>
            </div>
          </div>
        ))}

        <p class="note">
          The CI pipeline enforces a Lighthouse performance budget:
          performance ≥ 95, accessibility ≥ 95, SEO ≥ 100,
          best-practices ≥ 95. See <code>lighthouserc.js</code>.
        </p>
      </>
    ) : (
      <p>
        No Lighthouse report is currently available. Run {' '}
        <code>pnpm lighthouse:all</code> to generate one, then {' '}
        <code>pnpm quality:generate</code> to include it here.
      </p>
    )}
  </section>

  <hr />

  <section id="bundle-measurement">
    <h2>Production bundle</h2>

    <p class="methodology-note">
      Bundle figures are from the Astro-only production build in <code>dist/</code>.
      Storybook assets under <code>/design-system/lab/</code> are measured
      separately and are never loaded by ordinary site pages.
    </p>

    <h3>JavaScript files present in the deployment</h3>
    <p>
      These are all JavaScript files present in <code>dist/</code> (source maps
      excluded). Not every file is loaded by every route. See the
      route-measurement tables below for per-page behavior.
    </p>

    <table class="measurement-table">
      <thead>
        <tr><th>Category</th><th>Total bytes</th><th>Files</th></tr>
      </thead>
      <tbody>
        {staticDeployment.categories.map((cat: any) => (
          <tr>
            <td>{cat.name}</td>
            <td>{formatBytes(cat.bytes)}</td>
            <td>{cat.files}</td>
          </tr>
        ))}
        <tr class="total-row">
          <td><strong>Total</strong></td>
          <td><strong>{formatBytes(staticDeployment.totalJavaScript.bytes)}</strong></td>
          <td><strong>{staticDeployment.totalJavaScript.fileCount}</strong></td>
        </tr>
      </tbody>
    </table>

    <p class="methodology-note">{staticDeployment.note}</p>

    <h3>Route-level JavaScript references</h3>
    <p>
      Each row shows which JavaScript assets a route’s generated HTML
      references, their total size, and estimated inline script bytes.
    </p>

    <table class="measurement-table">
      <thead>
        <tr>
          <th>Route</th>
          <th>Referenced JS</th>
          <th>Total bytes</th>
          <th>Inline script bytes</th>
          <th>Features</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(routeMeasurements).map(([route, info]: [string, any]) => (
          <tr>
            <td><code>{route}</code></td>
            <td>{info.assets.length > 0
              ? info.assets.map((a: any) => `<code>${a.url.split('/').pop()}</code>`).join(', ')
              : 'none'
            }</td>
            <td>{formatBytes(info.totalBytes)}</td>
            <td>{formatBytes(info.inlineBytes)}</td>
            <td>{info.features.length > 0 ? info.features.join(', ') : 'core'}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <details>
      <summary>Full asset details by route</summary>
      {Object.entries(routeMeasurements).map(([route, info]: [string, any]) => (
        <div class="route-detail">
          <h4><code>{route}</code></h4>
          {info.assets.length > 0 ? (
            <table class="measurement-table">
              <thead>
                <tr><th>Asset</th><th>Bytes</th><th>Category</th></tr>
              </thead>
              <tbody>
                {info.assets.map((a: any) => (
                  <tr>
                    <td><code>{a.url}</code></td>
                    <td>{formatBytes(a.bytes)}</td>
                    <td>{a.category}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="methodology-note">No external JavaScript referenced.</p>
          )}
          <p class="methodology-note">Inline script bytes: {formatBytes(info.inlineBytes)}</p>
        </div>
      ))}
    </details>

    <h3>Feature-specific assets</h3>

    <table class="measurement-table">
      <thead>
        <tr><th>Feature</th><th>Deployment bytes</th><th>Routes requesting</th><th>Loading behavior</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Pagefind (search)</td>
          <td>{formatBytes(featureLoading.pagefind.totalDeployBytes)}</td>
          <td>{featureLoading.pagefind.routesRequesting.length > 0
            ? featureLoading.pagefind.routesRequesting.map((r: string) => `<code>${r}</code>`).join(', ')
            : 'none'}</td>
          <td>{featureLoading.pagefind.loadingBehavior}</td>
        </tr>
        <tr>
          <td>Partytown (analytics)</td>
          <td>{formatBytes(featureLoading.partytown.totalDeployBytes)}</td>
          <td>{featureLoading.partytown.routesRequesting.length > 0
            ? featureLoading.partytown.routesRequesting.map((r: string) => `<code>${r}</code>`).join(', ')
            : 'none'}</td>
          <td>{featureLoading.partytown.loadingBehavior}</td>
        </tr>
        <tr>
          <td>Turnstile (contact form)</td>
          <td>External</td>
          <td>{featureLoading.turnstile.routesRequesting.length > 0
            ? featureLoading.turnstile.routesRequesting.map((r: string) => `<code>${r}</code>`).join(', ')
            : 'none'}</td>
          <td>{featureLoading.turnstile.loadingBehavior}</td>
        </tr>
        <tr>
          <td>Storybook lab</td>
          <td>{componentLab ? formatBytes(componentLab.totalJavaScriptBytes) : '—'}</td>
          <td>{featureLoading.storybookLab.routesRequesting.length > 0
            ? featureLoading.storybookLab.routesRequesting.map((r: string) => `<code>${r}</code>`).join(', ')
            : 'none'}</td>
          <td>{featureLoading.storybookLab.loadingBehavior}</td>
        </tr>
      </tbody>
    </table>

    <h3>Component lab (Storybook)</h3>
    {componentLab ? (
      <>
        <p>
          The Storybook application at <code>/design-system/lab/</code> is a
          separate application. Its JavaScript is not loaded by ordinary blog
          pages. The isolation verification below confirms this.
        </p>

        <table class="measurement-table">
          <thead>
            <tr><th>Metric</th><th>Value</th></tr>
          </thead>
          <tbody>
            <tr><td>Total JavaScript</td><td>{formatBytes(componentLab.totalJavaScriptBytes)}</td></tr>
            <tr><td>Total JavaScript (gzip)</td><td>{formatBytes(componentLab.totalJavaScriptGzipBytes)}</td></tr>
            <tr><td>Files</td><td>{componentLab.fileCount}</td></tr>
          </tbody>
        </table>

        <details>
          <summary>Largest Storybook chunks</summary>
          <table class="measurement-table">
            <thead>
              <tr><th>Chunk</th><th>Size</th><th>Category</th></tr>
            </thead>
            <tbody>
              {componentLab.largestChunks.slice(0, 5).map((chunk: any) => (
                <tr>
                  <td><code>{chunk.name}</code></td>
                  <td>{formatBytes(chunk.bytes)}</td>
                  <td>{chunk.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </>
    ) : (
      <p>Storybook build output not available. Run <code>pnpm build:storybook</code> first.</p>
    )}
  </section>

  <hr />

  <section id="isolation">
    <h2>Storybook isolation</h2>

    <p>
      Storybook is built as a separate static application and copied into
      <code>dist/design-system/lab/</code> during deployment. It is not
      part of the Astro build graph and is not imported by any production
      component.
    </p>

    <table class="measurement-table">
      <thead>
        <tr><th>Check</th><th>Result</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Storybook assets isolated to <code>/design-system/lab/</code></td>
          <td>{isolation.isolated ? '✅' : '❌'}</td>
        </tr>
        <tr>
          <td>Static scan: Storybook references in production JS/CSS</td>
          <td>{isolation.contaminatedFiles} found{isolation.contaminatedFiles === 0 ? ' (clean)' : ''}</td>
        </tr>
        <tr>
          <td>Network test: ordinary pages loading Storybook assets</td>
          <td>0 (verified via Playwright)</td>
        </tr>
      </tbody>
    </table>

    <p class="methodology-note">
      {isolation.checkType} and confirmed by Playwright network-interception
      tests in <code>tests/storybook-isolation.spec.ts</code>.
    </p>

    {componentLab && (
      <p class="note">
        The Storybook bundle is approximately {formatBytes(componentLab.totalJavaScriptBytes)}
        (uncompressed). This is the weight of a design-system development tool,
        not the blog. It is served only to users who explicitly visit
        <code>/design-system/lab/</code>.
      </p>
    )}
  </section>

  <hr />

  <section id="accessibility">
    <h2>Accessibility verification</h2>

    {accessibility ? (
      <>
        <p>
          Automated accessibility checks run against every Storybook component
          story and every primary site route. The tests use axe-core through
          Playwright. Results come from the last <code>pnpm test:e2e</code> run.
        </p>

        <table class="measurement-table">
          <thead>
            <tr><th>Scope</th><th>Tests</th><th>Passed</th><th>Failed</th><th>Skipped</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>All a11y tests</td>
              <td>{accessibility.totalTests}</td>
              <td>{accessibility.passedTests}</td>
              <td>{accessibility.failedTests}</td>
              <td>{accessibility.skippedTests}</td>
            </tr>
            <tr>
              <td>Storybook component stories</td>
              <td>{accessibility.storybookTests}</td>
              <td>{accessibility.storybookPassed}</td>
              <td>{accessibility.storybookTests - accessibility.storybookPassed}</td>
              <td>—</td>
            </tr>
            <tr>
              <td>Site routes</td>
              <td>{accessibility.routeTests}</td>
              <td>{accessibility.routePassed}</td>
              <td>{accessibility.routeTests - accessibility.routePassed}</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>

        <div class="callout">
          <h3>What remains manual</h3>
          <p>{accessibility.note}</p>
        </div>
      </>
    ) : (
      <p>
        No accessibility test results available. Run <code>pnpm test:e2e</code> then{' '}
        <code>pnpm quality:generate</code> to populate this section.
      </p>
    )}
  </section>

  <hr />

  <section id="storybook">
    <h2>Component system (Storybook)</h2>

    <p>
      The component lab at <a href="/design-system/lab/">/design-system/lab/</a>
      documents every reusable Astro component in the design system. Stories
      cover default states, edge cases (long labels, narrow viewports), and
      fixture-backed composite layouts.
    </p>

    <table class="measurement-table">
      <thead>
        <tr><th>Metric</th><th>Value</th></tr>
      </thead>
      <tbody>
        <tr><td>Total stories</td><td>{stories.total || '—'}</td></tr>
        <tr><td>Component stories</td><td>{stories.componentStories || '—'}</td></tr>
        <tr><td>Foundation stories</td><td>{stories.foundationStories || '—'}</td></tr>
        {accessibility && (
          <tr><td>Storybook accessibility tests</td><td>{accessibility.storybookTests}</td></tr>
        )}
      </tbody>
    </table>

    <p>
      See <a href="/portfolio/design-system/">Design System Companion</a> for
      component documentation, design tokens, and usage guidelines.
    </p>
  </section>

  <hr />

  <section id="build-and-validation">
    <h2>Build and validation</h2>

    <p>
      The following commands protect the site. Most run in CI on every push
      to <code>main</code>.
    </p>

    <table class="measurement-table">
      <thead>
        <tr><th>Command</th><th>Purpose</th></tr>
      </thead>
      <tbody>
        {validation.commands.map((cmd: any) => (
          <tr>
            <td><code>{cmd.command}</code></td>
            <td>{cmd.purpose}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="methodology-note">{validation.ci}</p>
  </section>

  <hr />

  <section id="measurement-limitations">
    <h2>Measurement limitations</h2>
    <ul class="limitation-list">
      {limitations.map((limitation: string) => (
        <li>{limitation}</li>
      ))}
    </ul>
  </section>

  <hr />

  <section id="methodology">
    <h2>Methodology</h2>

    <table class="measurement-table">
      <thead>
        <tr><th>Measurement group</th><th>Type</th><th>Source</th></tr>
      </thead>
      <tbody>
        {siteQuality.provenance.measurements.map((m: any) => (
          <tr>
            <td><code>{m.group}</code></td>
            <td>{m.type}</td>
            <td>{m.source}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Layout>

<style>
  .page-intro .lede {
    font-size: var(--type-size-large);
    line-height: 1.55;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    max-width: var(--layout-rail-prose);
  }

  .measurement-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-component) var(--space-component-lg);
    margin-block: var(--space-component);
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-md);
    font-size: var(--type-size-small);
  }
  .measurement-meta div { display: flex; flex-direction: column; gap: var(--space-xs); }
  .measurement-meta dt { color: var(--text-muted); font-size: var(--type-size-small); }
  .measurement-meta dd { margin: 0; }
  .measurement-meta code { font-size: var(--type-size-small); }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-component);
    margin-block: var(--space-component);
  }

  .metric-card {
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .metric-card h3 {
    margin: 0;
    font-size: var(--type-size-small);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-label);
    color: var(--text-muted);
  }
  .metric-value {
    font-size: var(--type-size-h3);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-mono);
    color: var(--text-primary);
    line-height: 1.1;
  }
  .metric-label {
    font-size: var(--type-size-small);
    color: var(--text-secondary);
  }

  .measurement-table {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-component);
    font-size: var(--type-size-small);
  }
  .measurement-table th,
  .measurement-table td {
    text-align: left;
    padding: var(--space-sm) var(--space-inline);
    border-bottom: var(--size-border-pixel) solid var(--border-main);
    vertical-align: top;
  }
  .measurement-table th {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    white-space: nowrap;
  }
  .measurement-table code {
    font-size: var(--type-size-small);
    word-break: break-all;
  }
  .measurement-table .total-row td {
    border-top: 2px solid var(--border-main);
    border-bottom: none;
  }

  .lh-route-block {
    margin-block: var(--space-component-lg);
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-radius: var(--radius-md);
  }
  .lh-route-block h3 { margin-top: 0; }

  .note, .callout {
    padding: var(--space-component);
    background: var(--bg-surface);
    border-inline-start: 3px solid var(--brand-accent);
    border-radius: var(--radius-md);
    margin-block: var(--space-component);
    font-size: var(--type-size-small);
  }
  .callout h3 { margin-top: 0; font-size: var(--type-size-base); }

  .methodology-note {
    font-size: var(--type-size-small);
    color: var(--text-secondary);
    font-style: italic;
