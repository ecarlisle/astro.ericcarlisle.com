---
import { Image } from 'astro:assets';
import CategoryTag from '@ericcarlisle/design-system/components/CategoryTag.astro';
import avatarImage from '@images/eric-carlisle.png';
import BaseHead from '../components/BaseHead.astro';
import Card from '../components/Card.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '@styles/feed.css';
import { AUTHOR_NAME } from '../consts';
import { getSortedPosts } from '../lib/blog-utils';
import { getCategoryAccent, getCategoryIcon } from '../lib/category-accents';

const posts = (await getSortedPosts()).slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Eric Carlisle | Principal Frontend Engineer & UX Architect" description="Principal Frontend Engineer & UX Architect. Explore my portfolio, design systems, and technical writing on web performance, accessibility, and scalable frontend architecture." pageType="homepage" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1" data-pagefind-body>
      <header class="home-hero technical-surface">
        <div class="home-hero-content">
          <p class="terminal-eyebrow" aria-hidden="true">
            <span class="terminal-eyebrow__prompt">&gt;</span>
            <span class="terminal-eyebrow__path">~/profile</span>
          </p>
          <h1>Hi, I&rsquo;m Eric Carlisle.</h1>
          <p class="home-hero-role">Principal Frontend Engineer &amp; UX Architect</p>
          <p class="home-hero-lede">
            I help teams build better web experiences: accessible interfaces,
            scalable frontend systems, thoughtful design systems, and
            performance-minded architecture.
          </p>
          <p class="home-hero-sub">
            I bring together engineering depth, UX judgment, AI-assisted delivery
            practices, and a practical sense for what teams can maintain.
          </p>
          <div class="home-hero-actions">
            <a href="/portfolio" class="button">View portfolio <span aria-hidden="true">→</span></a>
            <a href="/blog" class="button button--outline">Read the blog <span aria-hidden="true">→</span></a>
          </div>
          <p class="home-hero-capabilities-label" id="core-capabilities-label">Core capabilities</p>
          <ul class="home-hero-chips" aria-labelledby="core-capabilities-label">
            <li><CategoryTag label="Frontend architecture" variant="chip" accent={getCategoryAccent('frontend architecture')} icon={getCategoryIcon('frontend architecture')} /></li>
            <li><CategoryTag label="Design systems" variant="chip" accent={getCategoryAccent('design systems')} icon={getCategoryIcon('design systems')} /></li>
            <li><CategoryTag label="Accessibility" variant="chip" accent={getCategoryAccent('accessibility')} icon={getCategoryIcon('accessibility')} /></li>
            <li><CategoryTag label="Performance" variant="chip" accent={getCategoryAccent('performance')} icon={getCategoryIcon('performance')} /></li>
            <li><CategoryTag label="UX strategy" variant="chip" accent={getCategoryAccent('ux strategy')} icon={getCategoryIcon('ux strategy')} /></li>
          </ul>
        </div>
        <div class="home-hero-avatar">
          <Image
            src={avatarImage}
            alt="Eric Carlisle"
            width={320}
            height={320}
            quality={85}
            loading="eager"
            decoding="async"
            class="avatar-img"
            widths={[140, 200, 280, 320]}
            sizes="(min-width: 800px) 280px, (min-width: 600px) 200px, 140px"
          />
        </div>
      </header>
      <section class="feed" aria-labelledby="latest-writing">
        <header class="collection-header feed-heading">
          <div>
            <p class="terminal-eyebrow section-index" aria-hidden="true">
              <span class="terminal-eyebrow__prompt">&gt;</span>
              <span class="terminal-eyebrow__path">~/field_notes</span>
            </p>
            <h2 id="latest-writing">Latest writing</h2>
          </div>
          <a href="/blog">Browse all articles <span aria-hidden="true">→</span></a>
        </header>
        <ul class="grid grid--cards grid--featured-first">
          {posts.map((post) => (
            <Card
              as="li"
              title={post.data.title}
              href={`/blog/${post.id}/`}
              author={AUTHOR_NAME}
              pubDate={post.data.pubDate}
              headingLevel="h3"
            >
              {post.data.heroImage && (
                <Image
                  slot="image"
                  src={post.data.heroImage}
                  alt={post.data.coverAlt || post.data.title}
                  width={720}
                  height={360}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <p>{post.data.description}</p>
            </Card>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  @media (min-width: 801px) {
    main {
      padding-top: var(--space-component-lg);
    }
  }

  /* ── Hero grid: two-column on desktop, stack on mobile ── */
  .home-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-section) var(--space-section);
    align-items: center;
    padding: var(--space-section) var(--space-component-lg);
    margin-inline: calc(-1 * var(--space-component-lg));
    margin-bottom: var(--space-component-lg);
  }

  .home-hero-content {
    max-width: var(--layout-rail-prose);
  }

  .home-hero h1 {
    margin-bottom: var(--space-xs);
  }

  .terminal-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-bottom: var(--space-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--type-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
  }

  .terminal-eyebrow__prompt {
    color: var(--accent-category-blue);
    font-weight: var(--font-weight-bold);
  }

  .terminal-eyebrow__path {
    color: var(--accent-category-moss);
  }

  /* ── Role/title eyebrow ── */
  .home-hero-role {
    font-family: var(--font-mono);
    font-size: var(--type-size-body);
    color: var(--text-muted);
    margin-bottom: var(--space-component);
    letter-spacing: 0.02em;
  }

  .home-hero-lede {
    font-size: var(--type-size-large);
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .home-hero-sub {
    color: var(--text-secondary);
    margin-bottom: var(--space-component);
  }

  /* ── Action buttons ── */
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-component);
    margin-bottom: var(--space-sm);
  }

  .home-hero-capabilities-label {
    margin-bottom: var(--space-inline);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--type-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
  }

  /* ── Identity chips (uses shared .tag class) ── */
  .home-hero-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline);
  }

  /* ── Avatar: standalone portrait with minimal ring ── */
  .home-hero-avatar {
    display: flex;
    justify-content: center;
  }

  .avatar-img {
    display: block;
    border-radius: 50%;
    width: 280px;
    height: 280px;
    object-fit: cover;
    box-shadow: 0 0 0 var(--size-border-pixel) var(--border-muted);
  }

  /* ── Feed heading ── */
  .feed-heading {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-component);
    padding-top: var(--space-component);
    border-top: 1px solid var(--border-main);
  }

  .feed-heading::before {
    position: absolute;
    top: -2px;
    left: 0;
    width: min(8rem, 28%);
    height: 3px;
    content: '';
    background: var(--brand-primary);
  }

  .feed-heading h2 {
    margin-bottom: 0;
    margin-top: 0;
  }

  .feed-heading a {
    flex: none;
  }

  :global(.grid--featured-first > :first-child) {
    overflow: hidden;
    isolation: isolate;
  }

  :global(.grid--featured-first > :first-child::before) {
    position: absolute;
    z-index: -1;
    top: -10rem;
    right: -7rem;
    width: 24rem;
    height: 24rem;
    content: '';
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
    filter: blur(72px);
    pointer-events: none;
  }

  /* ── Tablet and below ── */
  @media (max-width: 800px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: var(--space-component-lg);
      padding: var(--space-component-lg) var(--space-component);
      margin-inline: calc(-1 * var(--space-component));
      margin-bottom: var(--space-component-lg);
    }

    .home-hero-content {
      max-width: none;
    }

    .home-hero h1 {
      max-width: 15ch;
    }

    .home-hero-actions {
      justify-content: center;
    }

    .home-hero-chips {
      justify-content: center;
    }

    .home-hero-avatar {
      order: -1;
    }

    .avatar-img {
      width: 200px;
      height: 200px;
    }
  }

  @media (max-width: 600px) {
    .feed-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .avatar-img {
      width: 140px;
      height: 140px;
    }
  }
</style>
