---
import Layout from '../layouts/BlogPost.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const showTurnstileDevWarning = import.meta.env.DEV && !turnstileSiteKey;
---

<Layout pageType="contact" title="Contact" description="Get in touch with the blog author.">
  {sent ? (
    <div class="prose contact-section">
      <div
        id="contact-success"
        class="contact-success-card"
        role="status"
        tabindex="-1"
      >
        <div class="contact-success-icon" aria-hidden="true">🚀</div>
        <h2>Message launched 🚀</h2>
        <p>Thanks for reaching out. Your note is on its way to my inbox, and I&rsquo;ll get back to you soon.</p>
        <p class="contact-success-note">Transmission received. Coffee-fueled reply pending.</p>
      </div>
    </div>
  ) : (
    <div class="prose contact-section">
      <p>Have a question, suggestion, or just want to say hi? Fill out the form below and I&rsquo;ll get back to you as soon as possible.</p>
      <div
        id="contact-success"
        class="contact-success-card"
        role="status"
        tabindex="-1"
        hidden
      >
        <div class="contact-success-icon" aria-hidden="true">🚀</div>
        <h2>Message launched 🚀</h2>
        <p>Thanks for reaching out. Your note is on its way to my inbox, and I&rsquo;ll get back to you soon.</p>
        <p class="contact-success-note">Transmission received. Coffee-fueled reply pending.</p>
      </div>
      <form
        action="/api/contact"
        method="POST"
        id="contact-form"
        class="contact-form"
        data-contact-api-url={contactApiUrl}
      >
        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="given-name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          <span>Subject</span>
          <input type="text" name="subject" required autocomplete="off" />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="6" required autocomplete="off"></textarea>
        </label>

        <div class="honeypot" aria-hidden="true">
          <label for="botField">Leave this empty</label>
          <input id="botField" type="text" name="botField" autocomplete="off" tabindex="-1" />
        </div>

        <input type="hidden" name="ts" value="" />

        {turnstileSiteKey ? (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-response-field="true"
            data-response-field-name="cf-turnstile-response"
          ></div>
        ) : showTurnstileDevWarning ? (
          <p class="callout">
            Development warning: <code>PUBLIC_TURNSTILE_SITE_KEY</code> is not configured, so form verification is unavailable.
          </p>
        ) : null}

        <button type="submit" class="button contact-submit">Send Message</button>

        <p class="contact-error" id="contact-error" role="alert" hidden></p>
      </form>

      {turnstileSiteKey && (
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      )}
      <script is:inline type="module">
        const tsInput = document.querySelector('input[name="ts"]');
        if (tsInput) tsInput.value = Date.now().toString();

        const form = document.getElementById('contact-form');
        const submitBtn = form?.querySelector('.contact-submit');
        const errorEl = document.getElementById('contact-error');
        const successEl = document.getElementById('contact-success');

        if (form && submitBtn) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn.disabled) return;

            const formData = new FormData(form);
            const turnstileToken = formData.get('cf-turnstile-response');
            if (typeof turnstileToken !== 'string' || !turnstileToken.trim()) {
              if (errorEl) {
                errorEl.textContent = 'Please complete the verification challenge.';
                errorEl.hidden = false;
              }
              return;
            }

            const contactApiUrl = form.dataset.contactApiUrl;
            if (!contactApiUrl) {
              if (errorEl) {
                errorEl.textContent = 'The contact form is not configured. Please try again later.';
                errorEl.hidden = false;
              }
              return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending\u2026';
            if (errorEl) errorEl.hidden = true;

            try {
              const resp = await fetch(contactApiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(Object.fromEntries(formData)),
              });
              const data = await resp.json();
              if (resp.ok && data.ok) {
                form.hidden = true;

                if (errorEl) {
                  errorEl.hidden = true;
                  errorEl.textContent = '';
                }

                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = 'Send Message';
                }

                if (successEl) {
                  successEl.hidden = false;
                  successEl.focus();
                }
              } else {
                throw new Error(data.error || `Failed to send message (${resp.status})`);
              }
            } catch (err) {
              if (errorEl) {
                errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
                errorEl.hidden = false;
              }
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Message';
            }
          });
        }
      </script>
    </div>
  )}
</Layout>

<style>
  .contact-section {
    max-width: var(--layout-rail-prose);
    margin: 0 auto;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-component);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-inline);
    font-family: var(--font-copy);
    font-size: var(--type-size-body);
    color: var(--text-primary);
  }

  .contact-form input,
  .contact-form textarea {
    padding: var(--space-inline) var(--space-sm);
    font-family: var(--font-copy);
    font-size: var(--type-size-body);
    color: var(--text-primary);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-control);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast);
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: none;
    border-color: var(--color-action);
    box-shadow: 0 0 0 1px var(--color-action);
  }

  .contact-form .honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .contact-submit {
    align-self: flex-start;
    min-width: 160px;
    min-height: var(--size-touch-target-min);
  }

  .contact-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .contact-error {
    font-size: var(--type-size-small);
    color: var(--color-link);
    margin: 0;
  }

  .contact-success-card {
    padding: var(--space-component);
    background: var(--bg-surface);
    border: var(--size-border-pixel) solid var(--border-main);
    border-left: var(--size-border-thick) solid var(--color-success);
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .contact-success-icon {
    font-size: var(--type-size-h2);
    line-height: 1;
  }

  .contact-success-card h2 {
    margin: 0;
    font-size: var(--type-size-h2);
    line-height: var(--line-height-h2);
    color: var(--text-primary);
  }

  .contact-success-card p {
    margin: 0;
    color: var(--text-secondary);
  }

  .contact-success-card > * + * {
    margin-top: var(--space-component);
  }

  .contact-success-note {
    font-size: var(--type-size-small);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
</style>
