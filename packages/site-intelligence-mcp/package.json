{
  "name": "@ericcarlisle/site-intelligence-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only MCP (Model Context Protocol) server exposing a compact overview of the generated ericcarlisle.com site inventory.",
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  }
}
